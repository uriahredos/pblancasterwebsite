# Copy to .env for local use (node --env-file=.env app/server.js), or set these in your host's dashboard.
NODE_ENV=production
PORT=3000
# Where the database and uploaded photos live. Must be on a persistent disk.
DATA_DIR=/data
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Public address of the site, used for links in emails.
BASE_URL=https://your-site.example.com
# Timezone used for dates shown in the site and exports.
APP_TIMEZONE=America/New_York

# First start only: creates the first admin if there are no users yet. Remove after first login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Email notifications (optional - leave SMTP_HOST empty to turn off).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Pye-Barker Employee Portal <portal@example.com>
# Comma-separated. Who hears about new parts requests and training requests.
NOTIFY_TO=
# Comma-separated. An extra mailbox for the first office's once-a-day "new complaints" notice.
# (Each office's complaint reviewers get the notice anyway, at the email address on their own account.)
COMPLAINT_NOTIFY_TO=
# Hour of day (0-23, APP_TIMEZONE) when the complaint notice goes out.
COMPLAINT_DIGEST_HOUR=7

# Backups: a copy of the database is made every night at this hour (0-23) and the newest BACKUP_KEEP are kept.
# ("Back up now" copies are kept apart, the newest 5, and the copies made before an update, the newest 2.)
BACKUP_HOUR=2
BACKUP_KEEP=14
# Comma-separated. If set (and SMTP is set), each night's copy is emailed here. It contains everything,
# including anonymous complaints, so send it only to someone allowed to read those.
BACKUP_EMAIL_TO=
# Encrypts the database and its backups (SQLCipher 4, AES-256). At least 20 characters; Corporate > Security check offers one to copy.
# KEEP A COPY SOMEWHERE SAFE: without it the data cannot be opened again by anyone.
# To change the key later: put the new one in DB_KEY and the current one in DB_KEY_OLD, and restart. Photos and documents
# move to the new key in the background: leave DB_KEY_OLD until Corporate > Security check says it can be deleted.
# To turn encryption off again: keep DB_KEY, add DB_DECRYPT=yes, and restart. Leave both until the Security check says
# no photos or documents are still encrypted, then remove both.
# Either way, keep the old key on record for as long as any backup or photo archive downloaded while it was in use is kept.
DB_KEY=
DB_KEY_OLD=
# To bring a backup back: the name of one of the backups in /data/backups, for example portal-2026-11-18.db.
# The next start puts it in place of the database (the database from before is set aside, not deleted), once.
# Remove the setting afterwards; the Security check reminds you. See "Bringing a backup back" in the README.
#RESTORE_BACKUP=
# Only to start a new, empty site on purpose where backups of an earlier one exist. Remove it after that start.
#NEW_SITE=yes
# Hours a person may edit or cancel their own submission.
EDIT_WINDOW_HOURS=24

# The master account is normally the first admin ever created. Only set this if the Master badge
# landed on the wrong person: on the next start, this username becomes the one master account.
MASTER_USERNAME=

# The site locks after this many minutes without use (closing it always locks). 0 = timer off.
# Phones and tablets lock sooner than desk computers.
LOCK_AFTER_MINUTES_PHONE=10
LOCK_AFTER_MINUTES_DESKTOP=20

# A temporary password handed out by an admin stops working after this many days.
TEMP_PASSWORD_DAYS=14
