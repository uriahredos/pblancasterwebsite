# Copy to .env for local use (node --env-file=.env app/server.js), or set these in your host's dashboard.
NODE_ENV=production
PORT=3000
# Where the database and uploaded photos live. Must be on a persistent disk.
DATA_DIR=/data
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Public address of the site, used for links in emails.
BASE_URL=https://your-site.example.com
# Timezone used for dates shown in the site and exports.
APP_TIMEZONE=America/New_York

# First start only: creates the first admin if there are no users yet. Remove after first login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Email notifications (optional - leave SMTP_HOST empty to turn off).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Pye-Barker Lancaster Branch Portal <portal@example.com>
# Comma-separated. Who hears about new parts requests and training requests.
NOTIFY_TO=
# Comma-separated. Who gets the once-a-day "new complaints" notice.
COMPLAINT_NOTIFY_TO=
# Hour of day (0-23, APP_TIMEZONE) when the complaint notice goes out.
COMPLAINT_DIGEST_HOUR=17

# Backups: a copy of the database is made every night at this hour (0-23) and the newest BACKUP_KEEP are kept.
BACKUP_HOUR=2
BACKUP_KEEP=14
# Comma-separated. If set (and SMTP is set), each night's copy is emailed here. It contains everything,
# including anonymous complaints, so send it only to someone allowed to read those.
BACKUP_EMAIL_TO=
# Hours a person may edit or cancel their own submission.
EDIT_WINDOW_HOURS=24
