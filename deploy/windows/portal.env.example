# Settings for PB Portal on a Windows server. Copy to D:\PBPortal\portal.env and fill in.
# Keep this file readable only by Administrators and the account the service runs as.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
DATA_DIR=D:\PBPortal\data
BASE_URL=https://portal.example.com
APP_TIMEZONE=America/New_York
# Long random string. Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# The database key. MOVING FROM RENDER: use exactly the key Render has, or the data cannot be opened.
# A new site: at least 20 characters. Keep a copy somewhere safe, away from this server.
DB_KEY=
# Set by update.ps1 on every update. Do not edit by hand.
APP_VERSION=
# Video calls (optional): Cloudflare Realtime TURN key id and API token. Never commit real values. Leave empty to use free STUN only.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# Email (optional). Leave SMTP_HOST empty to turn email off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PB Portal <portal@example.com>
NOTIFY_TO=
# Nightly backups are written to DATA_DIR\backups. Hour of day (0-23) and how many nights to keep.
BACKUP_HOUR=2
BACKUP_KEEP=14
