<%- include('partials/header') %>
<p><a href="/admin/training">&larr; Training requests</a></p>
<h1>Training request · <%= t.display_name %><% if (t.cancelled_at) { %> <span class="tag off">Cancelled</span><% } %></h1>
<div class="card stack">
  <dl class="facts">
    <dt>Submitted</dt><dd><%= fmtDateTime(t.created_at) %></dd>
    <dt>Wants contact</dt><dd><%= t.wants_contact ? 'Yes' : 'No' %><% if (t.wants_contact && t.email) { %> · <%= t.email %><% } %></dd>
    <dt>Keep private</dt><dd><%= t.is_private ? 'Yes. Do not share who asked.' : 'No' %></dd>
  </dl>
  <p class="pre"><%= t.description %></p>
</div>

<% if (history.length) { %>
<h2>Changes</h2>
<ul class="records">
  <% history.forEach(function (h) { %>
  <li class="card">
    <p><strong><%= h.change === 'cancelled' ? 'Cancelled' : 'Edited' %></strong> by <%= h.display_name %>, <%= fmtDateTime(h.changed_at) %></p>
    <% if (h.before) { %><p class="meta pre">Before: <%= h.before.description %> · contact: <%= h.before.wants_contact ? 'Yes' : 'No' %> · private: <%= h.before.is_private ? 'Yes' : 'No' %></p><% } %>
  </li>
  <% }) %>
</ul>
<% } %>
<% if (!t.cancelled_at) { %>
<div class="rec-actions spaced">
  <a class="btn small" href="/training/<%= t.id %>/edit">Edit</a>
  <form method="post" action="/training/<%= t.id %>/cancel" data-confirm="Cancel this?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small" type="submit">Cancel it</button></form>
</div>
<% } %>
<h2>Status</h2>
<form method="post" action="/admin/training/<%= t.id %>/status" class="card stack">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Status
    <select name="status"><% Object.keys(labels.trainingStatus).forEach(function (k) { %><option value="<%= k %>" <%= k === t.status ? 'selected' : '' %>><%= labels.trainingStatus[k] %></option><% }) %></select>
  </label>
  <label>Reply to <%= t.display_name %> <span class="hint">Optional. They see it under My submissions.</span>
    <textarea name="admin_note" rows="3" maxlength="1000"><%= t.admin_note || '' %></textarea>
  </label>
  <button class="btn primary" type="submit">Save</button>
</form>
<%- include('partials/footer') %>
