<%- include('partials/header', { wide: true }) %>
<h1>Warehouse stock</h1>
<p class="lede">The main warehouse: what is on the shelf, what is running low and what to order.</p>
<%- include('partials/errors') %>
<div class="stats stock-figures">
  <a class="stat" href="/admin/stock"><span class="stat-label">Parts</span><span class="stat-num"><%= figures.tracked %></span><span class="stat-sub"><%= figures.items %> <%= figures.items === 1 ? 'item' : 'items' %> on the shelf<%= figures.noLevel ? ', ' + figures.noLevel + ' with no minimum yet' : '' %></span></a>
  <a class="stat <%= figures.low || figures.out ? 'request' : 'return' %>" href="/admin/stock?low=1"><span class="stat-label">Low or out</span><span class="stat-num"><%= figures.low + figures.out %></span><span class="stat-sub"><%= figures.out ? figures.out + ' out, ' + figures.low + ' low' : figures.low ? 'at or below minimum' : 'nothing below its minimum' %></span></a>
  <a class="stat" href="/admin/stock?low=1"><span class="stat-label">To order</span><span class="stat-num"><%= figures.orderUnits %></span><span class="stat-sub"><%= figures.toOrder ? 'items across ' + figures.toOrder + (figures.toOrder === 1 ? ' part' : ' parts') : 'nothing to order' %></span></a>
  <div class="stat"><span class="stat-label">Used in <%= useDays %> days</span><span class="stat-num"><%= figures.used %></span><span class="stat-sub">items out of the warehouse</span></div>
  <% if (showCost) { %><div class="stat"><span class="stat-label">Value on the shelf</span><span class="stat-num">$<%= dollars(figures.valueCents) %></span><span class="stat-sub"><%= figures.unpriced ? figures.unpriced + (figures.unpriced === 1 ? ' part has' : ' parts have') + ' no cost yet' : 'at catalog cost' %></span></div><% } %>
  <% if (figures.over) { %><div class="stat"><span class="stat-label">Over maximum</span><span class="stat-num"><%= figures.over %></span><span class="stat-sub">more on the shelf than wanted</span></div><% } %>
</div>
<% if (figures.movers.length || figures.soonest.length) { %>
<div class="stock-insights">
  <% if (figures.movers.length) { %><div class="card"><h2>Most used, last <%= useDays %> days</h2><ol><% figures.movers.forEach(function (p) { %><li><a href="/admin/stock/<%= p.id %>"><strong><%= p.part_number %></strong></a> <span class="hint"><%= p.used %> used, <%= p.on_hand %> left</span></li><% }) %></ol></div><% } %>
  <% if (figures.soonest.length) { %><div class="card"><h2>Running out soonest</h2><ol><% figures.soonest.forEach(function (p) { %><li><a href="/admin/stock/<%= p.id %>"><strong><%= p.part_number %></strong></a> <span class="hint">about <%= p.days_left %> <%= p.days_left === 1 ? 'day' : 'days' %> left at this pace</span></li><% }) %></ol></div><% } %>
</div>
<% } %>
<form method="get" class="filters card">
  <label class="grow">Search <input type="search" name="q" value="<%= q %>" placeholder="Part number or description"></label>
  <label class="choice"><input type="checkbox" name="low" value="1" <%= low ? 'checked' : '' %>> Low stock only</label>
  <div class="filter-actions"><button class="btn primary small" type="submit">Show</button><a class="btn small" href="/admin/stock">Clear</a><a class="btn small" href="/admin/stock/reorder.csv">Export what to order</a></div>
</form>
<div class="table-wrap">
<table>
  <thead><tr><th>Part</th><th>Description</th><th class="num">On hand</th><th class="num">Minimum</th><th class="num">Maximum</th><th class="num">Used, <%= useDays %> days</th><th>Level</th><th class="num">Order</th><th></th></tr></thead>
  <tbody>
  <% rows.forEach(function (p) { %>
  <tr>
    <td><a href="/admin/stock/<%= p.id %>"><strong><%= p.part_number %></strong></a></td>
    <td><%= p.description %></td>
    <td class="num"><strong><%= p.on_hand %></strong></td>
    <td class="num"><% if (p.min_level === null) { %><a class="hint" href="/admin/stock/<%= p.id %>#levels">Set</a><% } else { %><%= p.min_level %><% } %></td>
    <td class="num"><%= p.max_level === null ? '' : p.max_level %></td>
    <td class="num"><%= p.used || '' %></td>
    <td><% if (p.on_hand <= 0) { %><span class="tag overdue">Out</span><% } else if (p.low) { %><span class="tag request">Low</span><% } else if (p.over) { %><span class="tag">Over</span><% } else { %><span class="tag return">OK</span><% } %></td>
    <td class="num"><% if (p.order) { %><strong><%= p.order %></strong><% } %></td>
    <td><a href="/admin/stock/<%= p.id %>"><%= can('stock.manage') ? 'Update' : 'Open' %></a></td>
  </tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="9" class="empty"><%= total ? 'No parts match.' : 'Nothing is in the warehouse yet. Record a delivery or a count, or set a level below.' %></td></tr><% } %>
  </tbody>
</table>
</div>

<% if (can('stock.manage')) { %>
<h2>Set a minimum and maximum</h2>
<form method="post" action="/admin/stock" class="filters card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Part <span class="hint">Pick from the catalog or type your own</span> <input name="part_number" value="<%= values.part_number || '' %>" required maxlength="100" autocomplete="off" data-catalog placeholder="Number or name"></label>
  <label>Minimum <span class="hint">Alert when at or below this</span> <input name="min_level" value="<%= values.min_level || '' %>" inputmode="numeric" maxlength="6" autocomplete="off"></label>
  <label>Maximum <span class="hint">Order back up to this</span> <input name="max_level" value="<%= values.max_level || '' %>" inputmode="numeric" maxlength="6" autocomplete="off"></label>
  <div class="filter-actions"><button class="btn primary small" type="submit">Save levels</button></div>
</form>

<details class="mod-tools spaced">
<summary>Upload a count from a spreadsheet</summary>
<form method="post" action="/admin/stock/import" enctype="multipart/form-data" class="filters thread-tools">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label class="grow">CSV file <span class="hint">Columns: Part Number, On hand, and optionally Minimum and Maximum. Each part listed is set to that count as of now.</span>
    <input type="file" name="file" accept=".csv,.txt,text/csv" required>
  </label>
  <div class="filter-actions"><button class="btn primary small" type="submit">Upload count</button></div>
</form>
</details>
<% } %>
<%- include('partials/footer') %>
