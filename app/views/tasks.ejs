<%- include('partials/header') %>
<div class="title-row"><h1>Tasks</h1><% if (can('tasks.assign')) { %><a class="btn small" href="/admin/tasks">Manage tasks</a><% } %></div>
<% if (!open.length) { %><p class="card empty">Nothing to do right now.</p><% } %>
<ul class="records">
<% open.forEach(function (t) { %>
  <li class="card task <%= t.overdue ? 'overdue' : t.days !== null && t.days <= 1 ? 'soon' : '' %>" id="t<%= t.id %>">
    <details class="task-fold" data-task="<%= t.id %>" <%= t.isNew ? '' : 'open' %>>
    <summary>
    <div class="rec-head">
      <strong><%= t.title %></strong>
      <% if (t.isNew) { %><span class="tag new">New</span><% } %>
      <span class="tag st-<%= t.status %>"><%= t.statusName %></span>
      <% if (t.overdue) { %><span class="tag overdue">Overdue</span><% } %>
      <time><%= t.when %></time>
    </div>
    <% if (t.isNew) { %><p class="hint fold-hint">Tap to open this task.</p><% } %>
    </summary>
    <% if (t.details) { %><p class="pre"><%= t.details %></p><% } %>
    <p class="meta">From <%= t.by_name %>, <%= fmtDateTime(t.created_at) %></p>
    <% if (t.kind === 'inspection') { %><p class="task-go"><a class="btn primary" href="/inspection?task=<%= t.id %>">Do the vehicle inspection</a> <span class="hint">Sending it finishes this task. Six photos are required.</span></p><% } %>
    <%- include('partials/task_notes', { t: t }) %>
    <form method="post" action="/tasks/<%= t.id %>/update" class="filters task-update">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Status
        <select name="status">
          <% Object.keys(statuses).forEach(function (k) { %><option value="<%= k %>" <%= t.status === k ? 'selected' : '' %>><%= statuses[k] %></option><% }) %>
          <% if (t.kind !== 'inspection') { %><option value="done">Finished</option><% } %>
        </select>
      </label>
      <label class="grow">Note <span class="hint">Optional</span><input name="note" maxlength="500" autocomplete="off" placeholder="Where it stands, for <%= t.by_name %>"></label>
      <div class="filter-actions"><button class="btn primary small" type="submit">Save update</button></div>
    </form>
    </details>
  </li>
<% }) %>
</ul>
<% if (done.length) { %>
<h2>Finished</h2>
<ul class="records">
<% done.forEach(function (t) { %>
  <li class="card cancelled">
    <div class="rec-head"><span class="tag return">Finished</span><strong><%= t.title %></strong><time><%= fmtDateTime(t.done_at) %></time></div>
    <% if (t.notes.length) { %><%- include('partials/task_notes', { t: t }) %><% } else if (t.done_note) { %><p class="meta">Note: <%= t.done_note %></p><% } %>
    <% if (t.kind !== 'inspection') { %><form method="post" action="/tasks/<%= t.id %>/done"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link" type="submit">Not finished after all</button></form><% } %>
  </li>
<% }) %>
</ul>
<% } %>
<script src="/tasks.js?v=<%= assetV %>" defer></script>
<%- include('partials/footer') %>
