<%- include('partials/header', { wide: true }) %>
<div class="title-row"><h1>Users</h1></div>
<%- include('partials/users_tabs', { tab: 'positions' }) %>
<% if (saved !== undefined) { %><p class="flash ok"><%= saved ? saved + (saved === 1 ? ' change' : ' changes') + ' saved.' : 'Nothing was changed.' %></p><% } %>
<% if (problems.length) { %><div class="errors"><ul><% problems.forEach(function (m) { %><li><%= m %></li><% }) %></ul></div><% } %>

<h2 id="titles">1. Roles</h2>
<p class="lede">Say which role reports to which. That is the only thing that sets up the chart; nobody is assigned to a person by hand.</p>
<% if (roleTree.length) { %><div class="card"><div class="org-scroll roles-scroll"><div class="org"><ul><% roleTree.forEach(function (t) { %><%- include('partials/role_node', { node: t, level: 1 }) %><% }) %></ul></div></div></div><% } %>
<% if (canTitles) { %>
<form method="post" action="/admin/users/titles" data-no-live class="roles-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="table-wrap">
  <table class="positions titles-table">
    <thead><tr><th>Role</th><th>Reports to</th><th>Department</th><th>Profile it gives</th><th>People</th><th>Keep or tidy</th></tr></thead>
    <tbody>
    <% titles.forEach(function (t) { %>
    <tr>
      <td data-label="Role"><input name="tname_<%= t.id %>" value="<%= t.name %>" maxlength="80" autocomplete="off" aria-label="Role"></td>
      <td data-label="Reports to"><select name="tparent_<%= t.id %>" aria-label="Role <%= t.name %> reports to"><option value="">Nobody (top)</option><% titles.forEach(function (o) { if (o.id !== t.id) { %><option value="<%= o.id %>" <%= t.parent_id === o.id ? 'selected' : '' %>><%= o.name %></option><% } }) %></select></td>
      <td data-label="Department"><input name="tdept_<%= t.id %>" value="<%= t.department || '' %>" maxlength="60" autocomplete="off" aria-label="Department for <%= t.name %>"></td>
      <td data-label="Profile it gives"><select name="tprofile_<%= t.id %>" aria-label="Profile the role <%= t.name %> gives"><option value="">None</option><% if (t.profile_id && !profiles.some(function (pr) { return pr.id === t.profile_id; })) { %><option value="<%= t.profile_id %>" selected><%= t.profile_name %></option><% } %><% profiles.forEach(function (pr) { %><option value="<%= pr.id %>" <%= t.profile_id === pr.id ? 'selected' : '' %>><%= pr.name %></option><% }) %></select></td>
      <td data-label="People"><%= t.holders %></td>
      <td data-label="Keep or tidy"><select name="tact_<%= t.id %>" aria-label="Keep, remove or merge the role <%= t.name %>"><option value="">Keep</option><% if (!t.holders) { %><option value="del">Remove</option><% } %><optgroup label="Merge into"><% titles.forEach(function (o) { if (o.id !== t.id) { %><option value="merge:<%= o.id %>"><%= o.name %></option><% } }) %></optgroup></select></td>
    </tr>
    <% }) %>
    <tr class="new-title">
      <td data-label="New role"><input name="new_name" maxlength="80" autocomplete="off" placeholder="Add a role"></td>
      <td data-label="Reports to"><select name="new_parent" aria-label="The new role reports to"><option value="">Nobody (top)</option><% titles.forEach(function (o) { %><option value="<%= o.id %>"><%= o.name %></option><% }) %></select></td>
      <td data-label="Department"><input name="new_dept" maxlength="60" autocomplete="off" placeholder="Department"></td>
      <td data-label="Profile it gives"><select name="new_profile" aria-label="Profile the new role gives"><option value="">None</option><% profiles.forEach(function (pr) { %><option value="<%= pr.id %>"><%= pr.name %></option><% }) %></select></td>
      <td></td><td></td>
    </tr>
    </tbody>
  </table>
  </div>
  <p class="filter-actions"><button class="btn primary" type="submit">Save roles</button><span class="hint">The same roles are used by every office. If an office has nobody in a role, the next one up is used. A role's profile is given to people when they are put in the role from now on; people already in it keep the profile they have. Merging moves everyone to the role you pick.</span></p>
</form>
<% } else { %><p class="hint">Roles are the same for every office and are set by corporate. Need one that is not here? Ask a corporate admin.</p><% } %>

<h2>2. People</h2>
<p class="lede">Pick each person's role. Who they report to follows from it, and so does their profile when the role gives one.</p>
<% if (!people.length) { %><p class="empty">Nobody to show yet.</p><% } else { %>
<label class="grow pos-find">Find a person <input type="search" id="pos-find" placeholder="Start typing a name or role" autocomplete="off"></label>
<form method="post" action="/admin/users/positions" id="pos-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="table-wrap">
  <table class="positions">
    <thead><tr><th>Name</th><th>Role</th><th>Reports to</th></tr></thead>
    <tbody>
    <% people.forEach(function (p) { var known = titles.some(function (t) { return t.name.toLowerCase() === String(p.job_title || '').toLowerCase(); });
       var boss = p.manager_id ? (byOffice.get(p.branch_id) || []).find(function (m) { return m.id === p.manager_id; }) : null; %>
    <tr id="p<%= p.id %>" class="<%= focus === p.id ? 'focus' : '' %>">
      <td data-label="Name"><a href="/people/<%= p.id %>"><%= p.display_name %></a><% if (showOffice && p.branch) { %> <span class="pill"><%= p.branch %></span><% } %></td>
      <td data-label="Role"><select name="job_<%= p.id %>" aria-label="Role for <%= p.display_name %>" <%= focus === p.id ? 'autofocus' : '' %>><option value="">None yet</option><% if (p.job_title && !known) { %><option value="<%= p.job_title %>" selected disabled><%= p.job_title %> (not on the list)</option><% } %><% titles.forEach(function (t) { %><option value="<%= t.name %>" <%= t.name.toLowerCase() === String(p.job_title || '').toLowerCase() ? 'selected' : '' %>><%= t.name %></option><% }) %></select></td>
      <td data-label="Reports to" class="reports-to"><%= boss ? boss.display_name : 'Nobody' %><% if (boss && boss.job_title) { %> <span class="meta"><%= boss.job_title %></span><% } %></td>
    </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
  <div class="save-bar"><span class="meta" id="pos-count">No changes yet</span><button class="btn primary" type="submit">Save changes</button></div>
</form>
<script src="/positions.js?v=<%= assetV %>" defer></script>
<% } %>
<%- include('partials/footer') %>
