<%- include('partials/header') %>
<% if (!one) { %>
<aside class="social-links" aria-label="Pye-Barker on social media">
  <h2>Follow Pye-Barker</h2>
  <ul>
    <li><a href="https://www.instagram.com/pyebarkerfire/" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
      <span>Instagram</span></a></li>
    <li><a href="https://www.facebook.com/PyeBarkerFireSafety/" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M15.5 8H14a2 2 0 0 0-2 2v10M9.5 12.5h5.5"/></svg>
      <span>Facebook</span></a></li>
    <li><a href="https://www.linkedin.com/company/pye-barker-fire-%26-safety/" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V16M8 7.8v.1M12 16v-5.5M12 13a2.5 2.5 0 0 1 5 0V16"/></svg>
      <span>LinkedIn</span></a></li>
  </ul>
</aside>
<% } %>
<% if (one) { %><p class="back"><a class="back-link" href="/social">Social</a></p><% } else { %>
<h1>Social</h1>
<p class="lede">Share what is going on: a job well done, a new truck, a new baby, a fish you caught. Everyone in the company sees it. Keep customers' private details out of the picture.</p>
<% } %>
<%- include('partials/errors') %>
<% if (canPost && !one) { %>
<details class="card composer" id="composer" <%= errors.length || values.body ? 'open' : '' %>>
  <summary aria-label="Write a post">
    <%- include('partials/avatar', { who: user }) %>
    <span class="composer-prompt">What's on your mind, <%= String(user.display_name).split(' ')[0] %>?</span>
    <span class="composer-name"><%= user.display_name %></span>
  </summary>
  <form method="post" action="/social" enctype="multipart/form-data" class="stack social-new" data-once>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label><span class="sr">What would you like to share?</span>
      <textarea name="body" rows="5" maxlength="2000" placeholder="What's on your mind?"><%= values.body || '' %></textarea></label>
    <label>Add photos <span class="hint">Optional. Up to 6.</span>
      <input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple data-shrink="1600">
    </label>
    <button class="btn primary" type="submit">Post</button>
  </form>
</details>
<script src="/shrink.js?v=<%= assetV %>" defer></script>
<% } %>
<% var lastDay = null; posts.forEach(function (p) { %>
<% if (!one && p.day !== lastDay) { lastDay = p.day; %><h2 class="social-day"><%= p.day %></h2><% } %>
<article class="card social-post" id="s<%= p.id %>">
  <header class="social-head">
    <a href="/people/<%= p.user_id %>"><%- include('partials/avatar', { who: { id: p.user_id, display_name: p.display_name, photo_path: p.photo_path } }) %></a>
    <div class="social-who"><a href="/people/<%= p.user_id %>"><strong><%= p.display_name %></strong></a>
      <span class="meta"><%= [p.branch, one ? fmtDateTime(p.created_at) : timeOnly(p.created_at), p.edited_at ? 'Edited' : ''].filter(Boolean).join(' · ') %></span></div>
    <% if (p.mayRemove) { %>
    <details class="row-menu post-menu">
      <summary aria-label="Post options"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg></summary>
      <div class="row-menu-list">
        <% if (p.mine && canPost) { %><a href="/social/p/<%= p.id %>/edit">Edit</a><% } %>
        <form method="post" action="/social/<%= p.id %>/delete" data-no-live data-confirm="Delete this post?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger-text" type="submit">Delete</button></form>
      </div>
    </details>
    <% } %>
  </header>
  <% if (p.body) { %><p class="social-body"><%= p.body %></p><% } %>
  <% if (p.photos.length) { %>
  <div class="social-photos n<%= Math.min(p.photos.length, 4) %>">
    <% p.photos.forEach(function (ph) { %><a href="/wall/photo/<%= ph.id %>"><img src="/wall/photo/<%= ph.id %>" alt="Photo from <%= p.display_name %>" loading="lazy"></a><% }) %>
  </div>
  <% } %>
  <%- include('partials/reactions', { kind: 'social', item: p, back: one ? 'post' : '' }) %>
  <section class="social-comments" aria-label="Comments">
    <% if (p.hidden) { %><p><a href="/social/p/<%= p.id %>">See all <%= p.comment_count %> comments</a></p><% } %>
    <% p.comments.forEach(function (c) { %>
    <div class="social-comment" id="c<%= c.id %>">
      <%- include('partials/avatar', { who: { id: c.user_id, display_name: c.display_name, photo_path: c.photo_path }, size: 'sm' }) %>
      <div class="social-bubble"><a href="/people/<%= c.user_id %>"><strong><%= c.display_name %></strong></a> <span class="meta"><%= fmtDateTime(c.created_at) %><%= c.edited_at ? ' · Edited' : '' %></span>
        <p><%= c.body %></p>
      </div>
      <% if (c.mayRemove) { %>
      <details class="row-menu comment-menu">
        <summary aria-label="Comment options"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg></summary>
        <div class="row-menu-list">
          <% if (c.mine && canPost) { %><a href="/social/comment/<%= c.id %>/edit">Edit</a><% } %>
          <form method="post" action="/social/comment/<%= c.id %>/delete" data-no-live data-confirm="Delete this comment?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger-text" type="submit">Delete</button></form>
        </div>
      </details>
      <% } %>
    </div>
    <% }) %>
    <% if (canPost) { %>
    <form method="post" action="/social/<%= p.id %>/comment" class="social-reply" data-no-live>
      <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="page" value="<%= page %>"><% if (one) { %><input type="hidden" name="back" value="post"><% } %>
      <label class="grow"><span class="sr">Write a comment</span><input name="body" maxlength="1000" placeholder="Write a comment" autocomplete="off" required></label>
      <button class="btn small" type="submit">Send</button>
    </form>
    <% } %>
  </section>
</article>
<% }) %>
<% if (!one && !more) { %><p class="social-end"><%= posts.length ? "That's the end of the feed." : 'The feed is empty.' %> <%= canPost ? 'Say something!' : '' %><% if (canPost) { %> <a href="#composer" data-open-composer>Write a post</a><% } %></p><% } %>
<% if (!one && (page > 1 || more)) { %><p class="pager"><% if (page > 1) { %><a class="btn small" href="/social?page=<%= page - 1 %>">Newer</a><% } else { %><span></span><% } %><% if (more) { %><a class="btn small" href="/social?page=<%= page + 1 %>">Older</a><% } %></p><% } %>
<%- include('partials/footer') %>
