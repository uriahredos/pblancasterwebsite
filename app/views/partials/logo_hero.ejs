<%# The logo, assembled on the page from its own artwork: the P and the B slide together, the flame rises and
    flickers, the wording follows, and a few embers drift up. It plays once and comes to rest as the plain logo. %>
<div class="logo-hero" role="img" aria-label="Pye-Barker Fire &amp; Safety">
  <div class="logo-hero-in" aria-hidden="true">
    <span class="lh-mark">
      <img class="lh-p" src="/logo-p.png?v=<%= assetV %>" alt="" width="422" height="208">
      <img class="lh-b" src="/logo-b.png?v=<%= assetV %>" alt="" width="422" height="208">
      <img class="lh-flame" src="/logo-flame.png?v=<%= assetV %>" alt="" width="422" height="208">
    </span>
    <img class="lh-text" src="/logo.png" alt="" width="640" height="168">
    <span class="lh-ember e1"></span><span class="lh-ember e2"></span><span class="lh-ember e3"></span><span class="lh-ember e4"></span>
  </div>
</div>
