<% var lead = node.reports.filter(function (k) { return k.reports.length; }), crew = node.reports.filter(function (k) { return !k.reports.length; });
   var depts = crew.map(function (k) { return k.department || ''; }).filter(function (d, i, a) { return a.indexOf(d) === i; });
   var crewName = depts.length === 1 && depts[0] ? depts[0] : (lead.length ? 'Also reporting' : 'Team'); %>
<li>
  <a class="org-box lvl<%= Math.min(level, 3) %>" href="/people/<%= node.id %>"><strong><%= node.job_title || node.department || 'Team lead' %></strong><span><%= node.display_name %></span></a>
  <% if (node.reports.length) { %>
  <ul>
    <% lead.forEach(function (kid) { %><%- include('org_node', { node: kid, level: level + 1 }) %><% }) %>
    <% if (crew.length === 1) { %><li><a class="org-box lvl<%= Math.min(level + 1, 3) %>" href="/people/<%= crew[0].id %>"><strong><%= crew[0].job_title || crew[0].department || 'Team' %></strong><span><%= crew[0].display_name %></span></a></li>
    <% } else if (crew.length) { %><li><div class="org-box crew"><strong><%= crewName %></strong><ul class="org-crew"><% crew.forEach(function (k) { %><li><a href="/people/<%= k.id %>"><%= k.display_name %></a><% if (k.job_title) { %> <span><%= k.job_title %></span><% } %></li><% }) %></ul></div></li><% } %>
  </ul>
  <% } %>
</li>
