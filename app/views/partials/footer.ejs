</main>
<% if (user && !user.must_change_password) {
  // Phones: five fixed buttons along the bottom. Everything else is behind More.
  var at = function () { return Array.prototype.some.call(arguments, function (p) { return path === p || path.indexOf(p + '/') === 0; }); };
  var alertCount = alerts.reduce(function (n, a) { return n + a[0]; }, 0);
  var partsTab = can('parts.submit') ? '/parts' : can('parts.view') ? '/admin/parts' : '';
%>
<nav class="tabbar no-print" id="tabbar" aria-label="Quick links">
  <a href="/" <%- path === '/' ? 'aria-current="page"' : '' %>><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 4l8 7.5V20h-5.5v-5.5h-5V20H4z"/></svg><span>Home</span></a>
  <% if (partsTab) { %><a href="<%= partsTab %>" <%- at('/parts', '/admin/parts', '/admin/requests', '/admin/stock', '/admin/catalog') ? 'aria-current="page"' : '' %>><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 8 12 3.5 20.5 8v8L12 20.5 3.5 16zM3.5 8 12 12.5 20.5 8M12 12.5v8"/></svg><span>Parts</span></a><% } %>
  <a href="/tasks" <%- at('/tasks') ? 'aria-current="page"' : '' %>><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h14v15H5zM8.5 12l2.5 2.5 4.5-5"/></svg><span>Tasks</span><% if (badges.tasks) { %><b class="tab-count"><%= badges.tasks > 99 ? '99+' : badges.tasks %></b><% } %></a>
  <a href="/alerts" <%- at('/alerts') ? 'aria-current="page"' : '' %>><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 16.5V10a6 6 0 0 1 12 0v6.5l1.5 1.5h-15zM10 20.5h4"/></svg><span>Alerts</span><% if (alertCount) { %><b class="tab-count"><%= alertCount > 99 ? '99+' : alertCount %></b><% } %></a>
  <a href="#navbar" id="more-toggle" role="button" aria-controls="navbar" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5h16M4 12h16M4 17.5h16"/></svg><span>More</span></a>
</nav>
<% } %>
<%# Shown by site.js only on a phone's browser, never inside the installed app. %>
<aside class="install-bar no-print" id="install-bar" hidden aria-label="Get the app">
  <img src="/icons/icon-192.png" alt="" width="44" height="44">
  <div class="install-text">
    <strong>Get the PB Lancaster app</strong>
    <span id="install-how">Add it to your home screen for one-tap access.</span>
  </div>
  <div class="install-actions">
    <button type="button" class="btn primary small" id="install-go" hidden>Install</button>
    <button type="button" class="link" id="install-later">Not now</button>
  </div>
</aside>
</body>
</html>
