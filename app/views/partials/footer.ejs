</main>
<% if (user && !user.must_change_password && !(typeof locked !== 'undefined' && locked)) {
  // Phones: five fixed buttons along the bottom. Everything else is behind More.
  var at = function () { return Array.prototype.some.call(arguments, function (p) { return path === p || path.indexOf(p + '/') === 0; }); };
  var alertCount = alerts.reduce(function (n, a) { return n + a[0]; }, 0) + newThreads.length;
  var partsTab = can('parts.submit') ? '/parts' : can('parts.view') ? '/admin/parts' : '';
%>
<nav class="tabbar no-print" id="tabbar" aria-label="Quick links">
  <a href="/" <%- path === '/' ? 'aria-current="page"' : '' %>><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 4l8 7.5V20h-5.5v-5.5h-5V20H4z"/></svg><span>Home</span></a>
  <a href="/social" <%- at('/social') ? 'aria-current="page"' : '' %>><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.500 5.500h15v10.500h-8l-4.500 3.500v-3.500h-2.500z"/><path d="M8.500 9.500h7M8.500 12.500h4.500"/></svg><span>Social</span></a>
  <% if (partsTab) { %><a href="<%= partsTab %>" <%- at('/parts', '/admin/parts', '/admin/requests', '/admin/stock', '/admin/catalog') ? 'aria-current="page"' : '' %>><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 8 12 3.5 20.5 8v8L12 20.5 3.5 16zM3.5 8 12 12.5 20.5 8M12 12.5v8"/></svg><span>Parts</span></a><% } %>
  <a href="/tasks" <%- at('/tasks') ? 'aria-current="page"' : '' %>><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h14v15H5zM8.5 12l2.5 2.5 4.5-5"/></svg><span>Tasks</span><% if (badges.tasks) { %><b class="tab-count"><%= badges.tasks > 99 ? '99+' : badges.tasks %></b><% } %></a>
  <a href="#navbar" id="more-toggle" role="button" aria-controls="navbar" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5h16M4 12h16M4 17.5h16"/></svg><span>More</span></a>
</nav>
<% } %>
<% if (user && !user.must_change_password && !(typeof locked !== 'undefined' && locked) && can('messages.use')) { %>
<div class="dock no-print" id="dock" data-me="<%= user.id %>">
  <button type="button" class="dock-btn" id="dock-btn" aria-expanded="false" aria-controls="dock-panel" aria-label="Messages and calls" title="Messages and calls"><%- icons.chat %><b class="dock-count" id="dock-count" <%= badges.messages ? '' : 'hidden' %>><%= badges.messages %></b></button>
  <section class="dock-panel" id="dock-panel" hidden aria-label="Messages and calls">
    <div class="dock-head"><strong>Messages and calls</strong><a href="/messages" data-dock-close>All messages</a><button type="button" class="link" data-dock-close aria-label="Close">Close</button></div>
    <label class="dock-find"><span class="sr">Find someone</span><input type="search" id="dock-q" maxlength="60" placeholder="Find someone" autocomplete="off"></label>
    <div class="dock-body" id="dock-body" aria-live="polite"></div>
  </section>
</div>
<div class="ring no-print" id="ring" hidden role="alertdialog" aria-label="Incoming call">
  <div class="ring-box"><p class="ring-what" id="ring-what"></p><span class="ring-face" id="ring-face" aria-hidden="true"></span><p class="ring-who" id="ring-who"></p>
    <div class="ring-acts"><button type="button" class="ring-round no" id="ring-no"><span class="ring-ico"><%- icons.phone %></span>Decline</button><button type="button" class="ring-round yes" id="ring-yes"><span class="ring-ico"><%- icons.phone %></span>Answer</button></div></div>
</div>
<% } %>
<% if (user && !user.must_change_password && !(typeof locked !== 'undefined' && locked)) { %><div class="pcard no-print" id="pcard" hidden role="dialog" aria-label="Person"></div><script src="/dock.js?v=<%= assetV %>" defer></script><% } %>
<%# Shown by site.js only on a phone's browser, never inside the installed app. %>
<aside class="install-bar no-print" id="install-bar" hidden aria-label="Get the app">
  <img src="/icons/icon-192.png" alt="" width="44" height="44">
  <div class="install-text">
    <strong>Get the PB Portal app</strong>
    <span id="install-how">Add it to your home screen for one-tap access.</span>
  </div>
  <div class="install-actions">
    <button type="button" class="btn primary small" id="install-go" hidden>Install</button>
    <button type="button" class="link" id="install-later">Not now</button>
  </div>
</aside>
<aside class="install-bar no-print" id="alerts-bar" hidden aria-label="Turn on alerts">
  <img src="/icons/icon-192.png" alt="" width="44" height="44">
  <div class="install-text">
    <strong>Turn on alerts</strong>
    <span id="alerts-how">Get a notification on this device for new tasks, replies and announcements.</span>
  </div>
  <div class="install-actions">
    <button type="button" class="btn primary small" id="alerts-go">Turn on</button>
    <button type="button" class="link" id="alerts-later">Not now</button>
  </div>
</aside>
<script src="/alerts-prompt.js?v=<%= assetV %>" defer></script>
</body>
</html>
