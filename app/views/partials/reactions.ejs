<%# Reaction buttons under a post or announcement. Pass `kind`, `item` (with .reactions) and optionally `back`. %>
<form method="post" action="/react" class="reactions">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="kind" value="<%= kind %>"><input type="hidden" name="id" value="<%= item.id %>"><% if (typeof back !== 'undefined' && back) { %><input type="hidden" name="back" value="<%= back %>"><% } %>
  <% item.reactions.forEach(function (r) { %><button class="react <%= r.mine ? 'on' : '' %> <%= r.n ? '' : 'none' %>" type="submit" name="emoji" value="<%= r.key %>" aria-pressed="<%= r.mine ? 'true' : 'false' %>" title="<%= r.n ? r.label + ': ' + r.names : r.label %>"><span aria-hidden="true"><%= r.emoji %></span><% if (r.n) { %><span><%= r.n %></span><% } %><span class="sr"><%= r.label %><%= r.mine ? ', given by you' : '' %></span></button><% }) %>
</form>
