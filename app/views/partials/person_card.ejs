<%# The small card that opens from a person's name anywhere on the site. Phone and email show only when the person shares them. %>
<div class="pcard-top"><%- include('avatar', { who: p }) %><div class="pcard-text"><strong><%= p.display_name %></strong><% if (p.job_title || p.department) { %><span class="meta"><%= [p.job_title, p.department].filter(Boolean).join(' · ') %></span><% } %><% if (p.branch) { %><span class="meta"><%= p.branch %></span><% } %><% if (!p.active) { %><span class="meta">No longer here</span><% } %></div></div>
<% if (!mine && (p.email || p.phone)) { %>
<div class="pcard-acts">
  <% if (p.email) { %><a class="btn small primary teams" href="https://teams.microsoft.com/l/chat/0/0?users=<%= encodeURIComponent(p.email) %>" target="_blank" rel="noopener noreferrer">Teams</a><a class="btn small" href="mailto:<%= p.email %>">Email</a><% } %>
  <% if (p.phone) { %><a class="btn small" href="tel:<%= p.phone.replace(/[^0-9+]/g, '') %>">Call</a><% } %>
</div>
<% } %>
<a class="pcard-open" href="<%= mine ? '/profile' : '/people/' + p.id %>" data-no-card><%= mine ? 'My profile' : 'Open profile' %></a>
