<%# What the quick list shows: people found for what was typed, or favorites and the people last written to. %>
<% var row = function (p, sub, href, unread) { %>
<li class="<%= unread ? 'unread' : '' %>">
  <a class="dock-who" href="<%= href %>" data-no-card><%- include('avatar', { who: p, size: 'sm' }) %><span class="dock-text"><strong><%= p.display_name %></strong><% if (sub) { %><span class="meta"><%= sub %></span><% } %></span><% if (unread) { %><span class="tag new">New</span><% } %></a>
  <button type="button" class="dock-act" data-call-person="<%= p.id %>" data-mode="audio" aria-label="Voice call <%= p.display_name %>" title="Voice call"><%- icons.phone %></button>
  <button type="button" class="dock-act" data-call-person="<%= p.id %>" data-mode="video" aria-label="Video call <%= p.display_name %>" title="Video call"><%- icons.video %></button>
</li>
<% }; %>
<% if (q) { %>
  <% if (!found.length) { %><p class="empty">Nobody found. Try fewer letters.</p><% } else { %>
  <ul class="dock-list"><% found.forEach(function (p) { row(p, [p.job_title, p.branch].filter(Boolean).join(' · '), '/messages/with/' + p.id, false); }) %></ul>
  <% } %>
<% } else { %>
  <% if (favs.length) { %><h3>Favorites</h3><ul class="dock-list"><% favs.forEach(function (p) { row(p, [p.job_title, p.branch].filter(Boolean).join(' · '), '/messages/with/' + p.id, false); }) %></ul><% } %>
  <h3>Recent</h3>
  <% if (!recent.length) { %><p class="empty">Nobody yet. Type a name above to find someone.</p><% } else { %>
  <ul class="dock-list"><% recent.forEach(function (t) { var snip = t.last_kind === 'call' ? (t.last_from === me ? 'You called' : 'Called you') : (t.last_from === me ? 'You: ' : '') + (t.last_removed ? 'Message removed' : String(t.last_body).replace(/\s+/g, ' ').slice(0, 60));
    row({ id: t.other_id, display_name: t.other_name, photo_path: t.other_photo }, snip, '/messages/c/' + t.id, t.unread); }) %></ul>
  <% } %>
<% } %>
