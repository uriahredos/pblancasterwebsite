<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<title><%= title %> · Pye-Barker Lancaster Branch</title>
<meta name="theme-color" content="#09324f">
<script src="/theme.js?v=<%= assetV %>"></script>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<link rel="icon" href="/icons/icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="PB Lancaster">
<link rel="stylesheet" href="/styles.css?v=<%= assetV %>">
<script src="/site.js?v=<%= assetV %>" defer></script>
</head>
<body class="<%= user && !user.must_change_password ? 'has-tabbar' : '' %>">
<header class="top">
  <div class="banner">
    <div class="banner-in">
      <a class="brand" href="/">
        <span class="logo-plate"><img src="/logo.png" alt="Pye-Barker Fire &amp; Safety" width="640" height="168"></span>
        <span class="branch">Lancaster Branch</span>
      </a>
      <div class="who">
        <% if (user) { %>
        <a class="who-name" href="/account/password" title="Change password"><%= user.display_name %></a>
        <form method="post" action="/logout" class="who-out"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link" type="submit">Sign out</button></form>
        <% } %>
        <% if (user && !user.must_change_password) { var alertTotal = alerts.reduce(function (n, a) { return n + a[0]; }, 0) + badges.tasks; %>
        <details class="bell" id="bell">
          <summary aria-label="Notifications<%= alertTotal ? ', ' + alertTotal + ' waiting' : ', none' %>" title="Notifications">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2.5a6.5 6.5 0 0 0-6.5 6.5v3.2c0 .7-.25 1.38-.7 1.9L3.6 15.5a1.25 1.25 0 0 0 .95 2.06h14.9a1.25 1.25 0 0 0 .95-2.06l-1.2-1.4a2.9 2.9 0 0 1-.7-1.9V9A6.5 6.5 0 0 0 12 2.5zM9.6 19.3a2.5 2.5 0 0 0 4.8 0z"/></svg>
            <% if (alertTotal) { %><span class="bell-count"><%= alertTotal > 99 ? '99+' : alertTotal %></span><% } %>
          </summary>
          <div class="bell-list alert-items">
            <%- include('alert_list') %>
          </div>
        </details>
        <% } else { %>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch between light and dark mode" title="Light / dark mode">
          <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M20.4 14.6A8.5 8.5 0 0 1 9.4 3.6a.75.75 0 0 0-.98-.93A10 10 0 1 0 21.33 15.6a.75.75 0 0 0-.93-1z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg>
        </button>
        <% } %>
      </div>
    </div>
  </div>
  <div class="stripe" aria-hidden="true"></div>
  <% if (user && !user.must_change_password) {
    // The menu: a few plain links, then groups. Each entry is [permission or null, link, label, is-current, badge].
    var is = function (prefix) { return path === prefix || path.indexOf(prefix + '/') === 0; };
    var groups = [
      { name: 'Parts', items: [
        ['parts.submit', '/parts?action=take', 'Take parts', false],
        ['parts.submit', '/parts?action=return', 'Return parts', false],
        ['parts.submit', '/parts?action=request', 'Request parts', false],
        'divider',
        ['parts.view', '/admin/parts', 'Parts log', is('/admin/parts') && !is('/admin/parts/audit') && !is('/admin/parts/summary')],
        ['parts.view', '/admin/requests', 'Parts requests', is('/admin/requests'), badges.requests],
        ['parts.audit', '/admin/parts/audit', 'Audit', is('/admin/parts/audit')],
        ['parts.view', '/admin/stock', 'Stock', is('/admin/stock')],
        ['parts.view', '/admin/parts/summary', 'Usage summary', is('/admin/parts/summary') || is('/admin/weekly')],
        ['catalog.manage', '/admin/catalog', 'Catalog', is('/admin/catalog')]
      ], current: path === '/parts' },
      { name: 'Trucks', items: [
        ['inspections.submit', '/inspection', 'Truck inspection', path === '/inspection'],
        'divider',
        ['inspections.view', '/admin/inspections', 'Inspection log', is('/admin/inspections') && !is('/admin/inspections/checklist'), badges.inspections],
        ['inspections.manage', '/admin/inspections/checklist', 'Checklist', is('/admin/inspections/checklist')]
      ] },
      { name: 'Training', items: [
        ['training.submit', '/training', 'Request training', path === '/training'],
        ['training.submit', '/training/topics', 'Topics', is('/training/topics')],
        'divider',
        ['training.view', '/admin/training', 'Training log', is('/admin/training') && !is('/admin/training/sessions')],
        ['training.view', '/admin/training/sessions', 'Sessions', is('/admin/training/sessions')],
        ['certs.manage', '/admin/certs', 'Certifications', is('/admin/certs'), badges.certs]
      ] },
      { name: 'Team', items: [
        ['complaints.submit', '/complaint', 'Anonymous complaint', is('/complaint')],
        'divider',
        ['users.manage', '/admin/users', 'Users', is('/admin/users')],
        ['profiles.manage', '/admin/profiles', 'Profiles', is('/admin/profiles')],
        ['tasks.assign', '/admin/tasks', 'Manage tasks', is('/admin/tasks')],
        ['announcements.post', '/admin/announcements', 'Post announcements', is('/admin/announcements')],
        ['newsletters.manage', '/admin/newsletters', 'Newsletters', is('/admin/newsletters')],
        ['complaints.review', '/admin/complaints', 'Complaints', is('/admin/complaints')]
      ] },
      { name: 'Setup', items: [
        ['users.manage', '/poster', 'QR code sign', is('/poster')],
        ['activity.view', '/admin/activity', 'Activity log', is('/admin/activity')],
        ['backups', '/admin/backups', 'Backups', is('/admin/backups')],
        [user.scope === 'all' ? 'users.manage' : 'no.such.permission', '/admin/import', 'Import old data', is('/admin/import')]
      ] }
    ].map(function (g) {
      // Keep what this person may use; drop dividers left at an edge or doubled up.
      var kept = g.items.filter(function (it) { return it === 'divider' || can(it[0]); });
      kept = kept.filter(function (it, i) { return it !== 'divider' || (i > 0 && i < kept.length - 1 && kept[i - 1] !== 'divider' && kept.slice(i + 1).some(function (x) { return x !== 'divider'; }) && kept.slice(0, i).some(function (x) { return x !== 'divider'; })); });
      var links = kept.filter(function (it) { return it !== 'divider'; });
      return { name: g.name, items: kept, links: links,
        current: Boolean(g.current) || links.some(function (it) { return it[3]; }),
        badge: links.reduce(function (n, it) { return n + (it[4] || 0); }, 0) };
    }).filter(function (g) { return g.links.length; });
  %>
  <div class="navbar" id="navbar">
    <nav class="nav" aria-label="Main">
      <a href="/" <%- path === '/' ? 'aria-current="page"' : '' %>>Home</a>
      <a href="/notices" <%- path === '/notices' ? 'aria-current="page"' : '' %>>Announcements<% if (badges.notices) { %> <span class="badge" title="Unread"><%= badges.notices %></span><% } %></a>
      <% if (can('forum.use')) { %><a href="/discussions" <%- path.startsWith('/discussions') ? 'aria-current="page"' : '' %>>Discussions<% if (badges.forum) { %> <span class="badge" title="New replies to threads you follow"><%= badges.forum %></span><% } %></a><% } %>
      <a href="/tasks" <%- path === '/tasks' ? 'aria-current="page"' : '' %>>Tasks<% if (badges.tasks) { %> <span class="badge" title="Tasks to do"><%= badges.tasks %></span><% } %></a>
      <a href="/my" <%- path === '/my' ? 'aria-current="page"' : '' %>>My activity<% if (badges.updates) { %> <span class="badge" title="Updates you have not seen"><%= badges.updates %></span><% } %></a>
      <span class="nav-sep" aria-hidden="true"></span>
      <% groups.forEach(function (g) { %>
      <% if (g.links.length === 1) { var only = g.links[0]; %>
      <a href="<%= only[1] %>" <%- g.current ? 'aria-current="page"' : '' %>><%= only[2] %><% if (only[4]) { %> <span class="badge"><%= only[4] %></span><% } %></a>
      <% } else { %>
      <details class="menu">
        <summary <%- g.current ? 'aria-current="true"' : '' %>><%= g.name %><% if (g.badge) { %> <span class="badge"><%= g.badge %></span><% } %></summary>
        <div class="menu-list">
          <% g.items.forEach(function (it) { if (it === 'divider') { %><hr><% } else { %><a href="<%= it[1] %>" <%- it[3] ? 'aria-current="page"' : '' %>><%= it[2] %><% if (it[4]) { %> <span class="badge"><%= it[4] %></span><% } %></a><% } }) %>
        </div>
      </details>
      <% } %>
      <% }) %>
      <button type="button" class="theme-toggle nav-theme" id="theme-toggle" title="Switch between light and dark mode">
        <span class="icon-moon">Dark mode</span><span class="icon-sun">Light mode</span>
        <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M20.4 14.6A8.5 8.5 0 0 1 9.4 3.6a.75.75 0 0 0-.98-.93A10 10 0 1 0 21.33 15.6a.75.75 0 0 0-.93-1z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg>
      </button>
      <div class="nav-account">
        <span class="nav-sep" aria-hidden="true"></span>
        <a href="/settings/notifications">Notification settings</a>
        <a href="/account/password">Change password<span class="hint-light"><%= user.display_name %></span></a>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit">Sign out</button></form>
      </div>
    </nav>
  </div>
  <% } %>
</header>
<main class="<%= typeof wide !== 'undefined' && wide ? 'wide' : '' %>">
<% if (flash) { %><p class="flash <%= flash.type %>" role="status"><%= flash.text %></p><% } %>
