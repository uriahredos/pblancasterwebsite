<%- include('partials/header', { wide: true }) %>
<p class="back"><a class="back-link" href="/admin/inventory">Inventory</a></p>
<h1><%= place.name %></h1>
<p class="lede"><%= kinds[place.kind] %><% if (technician) { %> · <%= technician.display_name %><% } %><% if (!place.active) { %> · put away<% } %></p>
<div class="stats">
  <div class="stat"><span class="stat-label">On hand</span><span class="stat-num"><%= stats.items %></span><span class="stat-sub"><%= stats.items === 1 ? 'item' : 'items' %> across <%= stats.parts %> <%= stats.parts === 1 ? 'part' : 'parts' %></span></div>
  <% if (assignedItems) { %><a class="stat request" href="#assigned"><span class="stat-label">Assigned to jobs</span><span class="stat-num"><%= assignedItems %></span><span class="stat-sub"><%= stats.items - assignedItems %> available</span></a><% } %>
  <% if (showCost) { %><div class="stat"><span class="stat-label">Value</span><span class="stat-num">$<%= dollars(stats.value) %></span><span class="stat-sub"><%= stats.unpriced ? stats.unpriced + (stats.unpriced === 1 ? ' part has' : ' parts have') + ' no cost on file' : 'at today\'s costs' %></span></div><% } %>
  <div class="stat return"><span class="stat-label">Came in</span><span class="stat-num"><%= stats.cameIn %></span><span class="stat-sub">in the last <%= stats.days %> days</span></div>
  <div class="stat"><span class="stat-label">Went out</span><span class="stat-num"><%= stats.wentOut %></span><span class="stat-sub"><%= stats.used %> of them used on jobs</span></div>
  <div class="stat <%= stats.toCheck || stats.belowZero ? 'request' : 'return' %>"><span class="stat-label">To check</span><span class="stat-num"><%= stats.toCheck %></span><span class="stat-sub"><%= stats.belowZero ? stats.belowZero + (stats.belowZero === 1 ? ' part is' : ' parts are') + ' below zero' : 'nothing below zero' %></span></div>
</div>
<% if (stats.mostUsed.length) { %>
<p class="count"><strong>Most used in the last <%= stats.days %> days:</strong> <%= stats.mostUsed.map(function (p) { return p.part_number + ' (' + p.used + ')'; }).join(', ') %></p>
<% } %>
<% if (stats.last) { %><p class="hint">Last movement <%= fmtDateTime(stats.last) %>.</p><% } %>
<div class="table-wrap">
<table>
  <% var split = place.kind === 'warehouse' || holds.length > 0; /* a place with nothing assigned from it shows the one figure */ %>
  <thead><tr><th>Part</th><th>Description</th><th class="num">On hand</th><% if (split) { %><th class="num">Assigned</th><th class="num">Available</th><% } %><% if (showCost) { %><th class="num">Cost each</th><th class="num">Value</th><% } %></tr></thead>
  <tbody>
  <% rows.forEach(function (p) { %>
  <tr>
    <td><strong><%= p.part_number %></strong></td><td><%= p.description %></td><td class="num"><strong><%= p.on_hand %></strong></td>
    <% if (split) { %><td class="num"><%= p.assigned || '' %></td><td class="num"><strong<%- p.assigned && p.available <= 0 ? ' class="none-free"' : '' %>><%= p.available %></strong></td><% } %>
    <% if (showCost) { %><td class="num"><%= p.cost_cents === null ? '' : '$' + dollars(p.cost_cents) %></td><td class="num"><%= p.cost_cents === null ? '' : '$' + dollars(p.cost_cents * p.on_hand) %></td><% } %>
  </tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="<%= (showCost ? 5 : 3) + (split ? 2 : 0) %>" class="empty">Nothing is recorded here yet.</td></tr><% } %>
  </tbody>
</table>
</div>
<% if (holds.length) { %>
<h2 id="assigned">Assigned to jobs</h2>
<%- include('partials/assigned', { holds: holds, mayAssign: mayAssign, back: '/admin/inventory/locations/' + place.id, showWhere: false, showPart: true }) %>
<% } %>

<% if (can('inventory.export')) { %><p><a class="btn small" href="/admin/inventory/locations/<%= place.id %>/export.csv">Export this location</a></p><% } %>

<h2>Latest movements</h2>
<% var WHAT = { opening: 'On hand at the start', receive: 'Delivery', transfer: 'Moved', use: 'Used', return: 'Returned', adjust: 'Count or correction' }; %>
<div class="table-wrap">
<table>
  <thead><tr><th>When</th><th>Part</th><th class="num">In or out</th><th>What</th><th>Who</th><th></th></tr></thead>
  <tbody>
  <% history.forEach(function (m) { var incoming = m.to_id === place.id; %>
  <tr>
    <td class="nowrap"><%= fmtDateTime(m.created_at) %></td><td><%= m.part_number %></td>
    <td class="num"><strong><%= incoming ? '+' : '-' %><%= m.quantity %></strong></td>
    <td><%= WHAT[m.kind] %><% if (m.kind === 'transfer') { %> <%= incoming ? 'from ' + (m.from_name || '') : 'to ' + (m.to_name || '') %><% } %><% if (m.hold_job) { %> <span class="hint">assigned to job <%= m.hold_job %></span><% } %><% if (m.note) { %> <span class="hint"><%= m.note %></span><% } %><% if (m.submission_id) { %> <a href="/admin/parts/<%= m.submission_id %>">entry</a><% } %></td>
    <td><%= m.display_name || '' %></td>
    <td><% if (m.flagged && !incoming) { %><span class="tag request" title="This place did not have that many on record when they were taken.">To check</span><% } %></td>
  </tr>
  <% }) %>
  <% if (!history.length) { %><tr><td colspan="6" class="empty">Nothing has moved in or out yet.</td></tr><% } %>
  </tbody>
</table>
</div>

<% if (mayManage && place.active) { %>
<h2>Change this location</h2>
<form method="post" action="/admin/inventory/locations/<%= place.id %>" class="filters card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Name <input name="name" value="<%= place.name %>" required maxlength="60" autocomplete="off"></label>
  <% if (place.kind === 'vehicle') { %>
  <label class="grow">Whose it is <span class="hint">Handing the vehicle to someone else keeps what is in it.</span>
    <select name="user_id"><% if (technician) { %><option value="<%= place.user_id %>" selected><%= technician.display_name %></option><% } %><% free.forEach(function (p) { %><option value="<%= p.id %>"><%= p.display_name %></option><% }) %></select></label>
  <% } %>
  <div class="filter-actions"><button class="btn primary small" type="submit">Save</button></div>
</form>
<% if (place.kind !== 'warehouse') { %>
<form method="post" action="/admin/inventory/locations/<%= place.id %>/retire" data-confirm="Put <%= place.name %> away? Its history is kept.">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small" type="submit">Put this location away</button>
</form>
<% } %>
<% } %>
<%- include('partials/footer') %>
