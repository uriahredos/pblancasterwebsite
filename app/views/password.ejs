<%- include('partials/header') %>
<div class="narrow">
<h1>Change password</h1>
<% if (user.must_change_password) { %><p class="flash info">Choose your own password before you continue.</p><% } %>
<% if (error) { %><p class="flash err" role="alert"><%= error %></p><% } %>
<form method="post" action="/account/password" class="card stack">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Current password
    <input name="current" type="password" autocomplete="current-password" required>
  </label>
  <label>New password <span class="hint">At least <%= minPasswordLength %> characters</span>
    <input name="password" type="password" autocomplete="new-password" minlength="<%= minPasswordLength %>" required>
  </label>
  <label>New password again
    <input name="confirm" type="password" autocomplete="new-password" minlength="<%= minPasswordLength %>" required>
  </label>
  <button class="btn primary" type="submit">Save password</button>
</form>
<% if (!user.must_change_password) { %>
<h2 id="face-id">Face ID or fingerprint</h2>
<div class="card stack" id="passkey-setup" data-user="<%= user.id %>">
  <p class="plain">Get back into the site with your face or fingerprint instead of typing your password. Set it up once on each phone or computer you use. Your face or fingerprint never leaves the device.</p>
  <% if (passkeys.length) { %>
  <ul class="plain-list">
    <% passkeys.forEach(function (p) { %>
    <li><span><strong><%= p.device %></strong><span class="meta">Set up <%= fmtDate(p.created_at.slice(0, 10)) %><%= p.last_used_at ? ' · last used ' + fmtDateTime(p.last_used_at) : ' · not used yet' %></span></span>
      <form method="post" action="/passkey/<%= p.id %>/delete" data-confirm="Remove <%= p.device %>? It will need your password to get in."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link danger" type="submit">Remove</button></form></li>
    <% }) %>
  </ul>
  <% } %>
  <p class="flash err" id="passkey-error" role="alert" hidden></p>
  <button class="btn primary" type="button" id="passkey-add" hidden>Set up on this device</button>
  <p class="hint" id="passkey-unsupported" hidden>This browser or device does not offer Face ID or fingerprint sign-in. Your password still works.</p>
</div>
<h2>Email</h2>
<form method="post" action="/account/email" class="card stack">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Your email address <span class="hint">Used to send you a password-reset link and updates on your requests. Optional.</span>
    <input name="email" type="email" value="<%= user.email || '' %>" maxlength="120" autocomplete="email">
  </label>
  <button class="btn" type="submit">Save email</button>
</form>
<% } %>
</div>
<%- include('partials/footer') %>
