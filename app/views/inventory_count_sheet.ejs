<%- include('partials/header') %>
<% if (backToCount) { %><p class="back"><a class="back-link" href="/admin/inventory/count/<%= audit.id %>">Count for <%= monthName(audit.month) %></a></p><% } %>
<h1>Count: <%= place.name %></h1>
<p class="lede">Type how many of each part are really there. Leave a box empty if you have not counted that part. Save as often as you like and come back; mark it finished only when the whole place is counted.</p>
<% if (finished) { %><p class="flash ok">Marked as finished<%= finished.by_name ? ' by ' + finished.by_name : '' %>, <%= fmtDateTime(finished.done_at) %>. You can still change a number and save.</p><% } %>
<%- include('partials/errors') %>
<form method="post" action="/admin/inventory/count/<%= audit.id %>/<%= place.id %>" class="stack" data-no-live id="count-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <p><button type="button" class="btn primary" id="scan-btn" hidden>Count with the scanner</button></p>
  <% if (waiting) { %><p class="hint" id="waiting-note"><%= waiting %> <%= waiting === 1 ? 'item here is' : 'items here are' %> waiting to be identified from <%= waiting === 1 ? 'its photo' : 'their photos' %>.</p><% } %>
  <fieldset>
    <legend>Something here that is not on the list below?</legend>
    <label>Part <span class="hint">Pick from the catalog or type your own</span> <input name="add_part" id="add-part" value="<%= added %>" maxlength="100" autocomplete="off" data-catalog placeholder="Number or name"></label>
    <label>How many <input name="add_qty" id="add-qty" inputmode="numeric" maxlength="6" autocomplete="off"></label>
    <button class="btn small" type="submit">Add it to the list</button>
  </fieldset>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Part</th><th class="num">How many</th></tr></thead>
    <tbody>
    <% rows.forEach(function (p) { %>
    <tr data-part="<%= p.part_number.toUpperCase() %>">
      <td><label for="q<%= p.id %>"><strong><%= p.part_number %></strong><br><span class="hint"><%= p.description %></span></label></td>
      <td class="num"><input class="count-box" id="q<%= p.id %>" name="qty_<%= p.id %>" value="<%= p.counted === null ? '' : p.counted %>" inputmode="numeric" maxlength="6" autocomplete="off"></td>
    </tr>
    <% }) %>
    <% if (!rows.length) { %><tr><td colspan="2" class="empty">The records show nothing here. Add what you find above.</td></tr><% } %>
    </tbody>
  </table>
  </div>
  <div class="count-actions">
    <button class="btn" type="submit">Save and come back later</button>
    <% if (finished) { %><button class="btn" type="submit" name="finish" value="reopen">Not finished after all</button>
    <% } else { %><button class="btn primary" type="submit" name="finish" value="1" data-confirm-button="Mark <%= place.name %> as finished? Parts left empty are treated as not counted.">Save and mark as finished</button><% } %>
  </div>
</form>
<div class="scan-overlay" id="scan-overlay" hidden>
  <div class="scan-box card">
    <p id="scan-title"><strong>Point the camera at the barcode</strong></p>
    <div id="scan-view"></div>
    <p class="hint" id="scan-msg" role="status">Starting the camera…</p>
    <div id="scan-result" class="scan-result" hidden>
      <p id="scan-what"></p>
      <label id="scan-part-row">Which part is it? <span class="hint">Pick from the catalog or type its part number. The barcode is remembered from now on.</span>
        <input id="scan-part" maxlength="100" autocomplete="off" data-catalog placeholder="Number or name"></label>
      <label>How many <input id="scan-qty" inputmode="numeric" maxlength="6" autocomplete="off"></label>
      <p class="flash err" id="scan-error" hidden></p>
      <p class="filter-actions"><button type="button" class="btn primary" id="scan-save">Save and scan next</button><button type="button" class="btn" id="scan-skip">Skip</button></p>
      <p><button type="button" class="link" id="scan-wrong" hidden>Not this part</button></p>
      <details id="scan-photo-row" class="mod-tools">
        <summary>Not sure what it is? Take a photo</summary>
        <div class="thread-tools stack">
          <label>Photo of the part or its label <input type="file" id="scan-photo" accept="image/jpeg,image/png,image/webp" capture="environment" data-shrink="1600"></label>
          <button type="button" class="btn" id="scan-photo-save">Save the photo and scan next</button>
        </div>
      </details>
    </div>
    <button type="button" class="btn" id="scan-close">Done scanning</button>
  </div>
</div>
<script src="/shrink.js?v=<%= assetV %>" defer></script>
<script src="/count.js?v=<%= assetV %>" defer></script>
<script src="/scan.js?v=<%= assetV %>" defer></script>
<%- include('partials/footer') %>
