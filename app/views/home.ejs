<%- include('partials/header') %>
<%
  // Small line icons for the quick actions.
  var icons = {
    take: '<path d="M4 9.5 12 5l8 4.5v8L12 22l-8-4.5z"/><path d="M4 9.5 12 14l8-4.5M12 14v8"/><path d="M12 9V2m0 0L9.5 4.5M12 2l2.5 2.5"/>',
    back: '<path d="M4 9.5 12 5l8 4.5v8L12 22l-8-4.5z"/><path d="M4 9.5 12 14l8-4.5M12 14v8"/><path d="M12 2v7m0 0L9.5 6.5M12 9l2.5-2.5"/>',
    request: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1M12 9.5v6M9 12.5h6"/>',
    training: '<path d="M2.5 9 12 4.5 21.5 9 12 13.5z"/><path d="M6.5 11v4.5c1.6 1.5 3.4 2.2 5.5 2.2s3.9-.7 5.5-2.2V11M21.5 9v5.5"/>',
    truck: '<path d="M2.5 6.5h11v10h-11zM13.5 10h4l3 3v3.5h-7z"/><circle cx="7" cy="17.5" r="1.9"/><circle cx="17" cy="17.5" r="1.9"/>',
    complaint: '<path d="M4 5h16v11H10l-4.5 3.5V16H4z"/><path d="M8 9.5h8M8 12.5h5"/>',
    talk: '<path d="M3.5 5h11v8h-6l-3 2.5V13h-2z"/><path d="M17 9h3.5v8h-2v2.5l-3-2.5h-5v-2"/>',
    people: '<circle cx="9" cy="8.5" r="3.2"/><path d="M3 19.5c.6-3.2 2.9-5 6-5s5.4 1.8 6 5"/><circle cx="17" cy="9.5" r="2.4"/><path d="M16.5 14.6c2.4.2 4 1.7 4.5 4.4"/>',
    mine: '<path d="M9 6.5h11M9 12h11M9 17.5h11"/><path d="m3.5 6.5 1.2 1.2 2-2.4M3.5 12l1.2 1.2 2-2.4M3.5 17.5l1.2 1.2 2-2.4"/>'
  };
  var icon = function (name) { return '<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' + icons[name] + '</svg>'; };
%>
<div class="dash-hello">
  <h1>Hi, <%= user.display_name %></h1>
  <p class="dash-date"><%= dateLine %></p>
</div>

<% if (critical.length) { %>
<section class="critical" aria-label="Critical announcements">
<% critical.forEach(function (n) { %>
<div class="card critical-card">
  <div class="rec-head"><span class="tag crit">Critical</span><% if (!n.read_at) { %><span class="tag new">New</span><% } %><% if (n.category !== 'general') { %><span class="tag cat-<%= n.category %>"><%= categories[n.category] %></span><% } %><strong><%= n.title %></strong><time><%= n.author %>, <%= fmtDateTime(n.created_at) %></time></div>
  <p class="pre"><%= n.body %></p>
  <% if (!n.read_at) { %>
  <form method="post" action="/notices/<%= n.id %>/read"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="home"><button class="btn primary small" type="submit">I have read this</button></form>
  <% } else { %><p class="meta">You read this on <%= fmtDateTime(n.read_at) %><%= n.expires_on ? '. Showing until ' + fmtDate(n.expires_on) : '' %>.</p><% } %>
</div>
<% }) %>
</section>
<% } %>

<% if (!hasPasskey) { %>
<div class="card tip-card" id="passkey-tip" hidden>
  <p><strong>Get in with your face or fingerprint.</strong> The site now locks when you close it. Set up Face ID or fingerprint so you do not have to type your password each time.</p>
  <span class="tip-actions"><a class="btn primary small" href="/account/password#face-id">Set it up</a><button type="button" class="link" id="passkey-tip-no">Not now</button></span>
</div>
<% } %>

<% if (profileEmpty) { %>
<div class="card tip-card" id="profile-tip">
  <p><strong>Tell people who you are.</strong> Add a photo, your job and what you know about, so people across the company can put a face to your name.</p>
  <span class="tip-actions"><a class="btn primary small" href="/profile">Fill in my profile</a></span>
</div>
<% } %>

<% if (branch.length) { %>
<section class="panel branch-panel" aria-labelledby="branch-h">
  <div class="panel-head"><h2 id="branch-h"><%= branchTitle %></h2></div>
  <div class="branch-stats">
    <% branch.forEach(function (s) { %>
    <a href="<%= s.url %>" class="<%= s.level %>"><span class="mini-num"><%= s.value %></span><span class="mini-label"><%= s.label %></span><span class="mini-sub"><%= s.sub %></span></a>
    <% }) %>
  </div>
</section>
<% } %>

<% if (myCerts.length || replies.length) { %>
<section class="attention" aria-label="Needs your attention">
<% if (replies.length) { %>
<div class="card replies-card">
  <div class="rec-head"><span class="tag new">New replies</span><strong>In threads you follow</strong></div>
  <ul class="replies">
    <% replies.forEach(function (t) { %>
    <li><a href="/discussions/t/<%= t.id %>"><strong><%= t.last_author %></strong> replied in <strong><%= t.title %></strong></a><span class="meta"><%= fmtDateTime(t.last_post_at) %></span></li>
    <% }) %>
  </ul>
</div>
<% } %>
<% myCerts.forEach(function (c) { %>
<p class="flash <%= c.status === 'expired' ? 'err' : 'warn' %>"><strong><%= c.name %></strong> <%= c.status === 'expired' ? 'expired on ' + fmtDate(c.expires_on) : c.days === 0 ? 'expires today' : 'expires in ' + c.days + (c.days === 1 ? ' day' : ' days') + ', on ' + fmtDate(c.expires_on) %>. Tell your manager when it is renewed.</p>
<% }) %>
</section>
<% } %>

<div class="dash">
  <div class="dash-main">
    <% if (myTasks.length) { %>
    <section class="panel p-tasks" aria-labelledby="tasks-h">
      <div class="panel-head"><h2 id="tasks-h">Your tasks</h2><a href="/tasks">All tasks</a></div>
      <ul class="todo">
        <% myTasks.forEach(function (t) { %>
        <li class="<%= t.overdue ? 'overdue' : t.days !== null && t.days <= 1 ? 'soon' : '' %>"><a href="/tasks#t<%= t.id %>"><strong><%= t.title %></strong><span class="todo-when"><%= t.when %> · from <%= t.by_name %></span></a></li>
        <% }) %>
      </ul>
      <% if (badges.tasks > myTasks.length) { %><p class="panel-foot"><a href="/tasks">and <%= badges.tasks - myTasks.length %> more</a></p><% } %>
    </section>
    <% } %>
    <% if (welcomes.length) { %>
    <section class="panel p-welcome" aria-labelledby="welcome-h" id="welcome">
      <div class="panel-head"><h2 id="welcome-h">Welcome aboard</h2><a href="/people">Everyone</a></div>
      <ul class="hires">
        <% welcomes.forEach(function (w) { %>
        <li>
          <a class="hire" href="/people/<%= w.user_id %>">
            <%- include('partials/avatar', { who: { id: w.user_id, display_name: w.display_name, photo_path: w.photo_path }, size: 'lg' }) %>
            <span class="person-text"><strong><%= w.display_name %></strong><span class="meta"><%= [w.job_title, w.branch ? w.branch + ' branch' : ''].filter(Boolean).join(' · ') || 'New to the team' %></span></span>
          </a>
          <% if (w.intro) { %><p class="hire-intro"><%= w.intro %></p><% } %>
          <div class="hire-foot">
            <span class="meta"><%= w.waves ? w.waves + (w.waves === 1 ? ' person has' : ' people have') + ' said welcome' : 'Be the first to say welcome' %></span>
            <% if (w.user_id === user.id) { %><a class="btn small" href="/people/<%= w.user_id %>#welcome">See your messages</a>
            <% } else if (w.waved) { %><a class="btn small" href="/people/<%= w.user_id %>#welcome">You said welcome ✓</a>
            <% } else { %><form method="post" action="/welcome/<%= w.id %>/wave"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="home"><button class="btn primary small" type="submit">👋 Say welcome</button></form><% } %>
          </div>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>
    <section class="panel p-board" aria-labelledby="board-h">
      <div class="panel-head"><h2 id="board-h">Announcements</h2><a href="/notices">All announcements</a></div>
      <% notices.forEach(function (n) { %>
      <div class="notice-card unread-card cat-<%= n.category %>">
        <div class="rec-head"><span class="tag new">New</span><% if (n.category !== 'general') { %><span class="tag cat-<%= n.category %>"><%= categories[n.category] %></span><% } %><strong><%= n.title %></strong><time><%= n.author %>, <%= fmtDateTime(n.created_at) %></time></div>
        <p class="pre"><%= n.body %></p>
        <form method="post" action="/notices/<%= n.id %>/read"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="home"><button class="btn primary small" type="submit">I have read this</button></form>
      </div>
      <% }) %>
      <% if (!board.length && !notices.length) { %><p class="empty"><%= critical.length ? 'Nothing else posted right now.' : 'No announcements right now.' %></p><% } %>
      <ul class="board">
        <% board.forEach(function (n) { %>
        <li class="cat-<%= n.category %>">
          <a href="/notices#n<%= n.id %>">
            <span class="board-top"><% if (n.pinned) { %><span class="tag pin">Pinned</span><% } %><% if (n.category !== 'general') { %><span class="tag cat-<%= n.category %>"><%= categories[n.category] %></span><% } %><strong><%= n.title %></strong></span>
            <span class="board-body"><%= n.body %></span>
            <span class="board-meta"><%= n.author %> · <%= dateOnly(n.created_at) %></span>
          </a>
        </li>
        <% }) %>
      </ul>
    </section>
    <section class="panel news p-news" aria-labelledby="news-h">
      <div class="panel-head"><h2 id="news-h">The Monthly Barker</h2><% if (issue) { %><a href="/newsletters">All issues</a><% } %></div>
      <% if (issue) { %>
      <div class="issue">
        <a class="issue-cover" href="/newsletters/<%= issue.id %>" aria-label="Read the <%= issue.month %> newsletter">
          <% if (issue.pages.length) { %><img src="/newsletters/<%= issue.id %>/page/1" alt="" width="1100" height="1424"><% } else { %><span class="cover-blank"><span><%= issue.month.split(' ')[0] %></span><%= issue.month.split(' ')[1] %></span><% } %>
        </a>
        <div class="issue-body">
          <p class="eyebrow">Latest issue</p>
          <h3><%= issue.title %></h3>
          <% if (issue.highlightList.length) { %>
          <ul class="highlights"><% issue.highlightList.slice(0, 4).forEach(function (h) { %><li><%= h %></li><% }) %></ul>
          <% } else { %><p class="meta">Birthdays, anniversaries, branch news and this month's spotlight.</p><% } %>
          <a class="btn primary" href="/newsletters/<%= issue.id %>">Read this issue</a>
        </div>
      </div>
      <% if (pastIssues.length) { %>
      <div class="past">
        <p class="eyebrow">Past issues</p>
        <div class="past-row">
          <% pastIssues.forEach(function (p) { %>
          <a class="past-issue" href="/newsletters/<%= p.id %>">
            <% if (p.pages.length) { %><img src="/newsletters/<%= p.id %>/page/1" alt="" loading="lazy" width="1100" height="1424"><% } else { %><span class="cover-blank small"><span><%= p.month.split(' ')[0].slice(0, 3) %></span><%= p.month.split(' ')[1] %></span><% } %>
            <span><%= p.month %></span>
          </a>
          <% }) %>
        </div>
      </div>
      <% } %>
      <% } else { %>
      <p class="empty">No newsletter has been posted yet.<% if (can('newsletters.manage')) { %> <a href="/admin/newsletters">Upload the first one</a>.<% } %></p>
      <% } %>
    </section>
    <% if (can('forum.use')) { %>
    <section class="panel p-talk" aria-labelledby="talk-h">
      <div class="panel-head"><h2 id="talk-h">Discussions</h2><a href="/discussions">All discussions</a></div>
      <% if (!talk.length) { %><p class="empty">Nothing posted yet. <a href="/discussions/new">Start the first thread</a>.</p><% } else { %>
      <ul class="threads compact">
        <% talk.forEach(function (t) { %>
        <li class="<%= t.unread ? 'unread' : '' %>">
          <a href="/discussions/t/<%= t.id %>">
            <span class="thread-top"><% if (t.solved_at) { %><span class="tag solved">Solved</span><% } %><strong><%= t.title %></strong></span>
            <span class="thread-meta"><%= t.section %> · <%= t.reply_count %> <%= t.reply_count === 1 ? 'reply' : 'replies' %> · <%= t.last_author %>, <%= dateOnly(t.last_post_at) %></span>
          </a>
        </li>
        <% }) %>
      </ul>
      <p class="panel-foot"><a class="btn small" href="/discussions/new">Start a thread</a></p>
      <% } %>
    </section>
    <% } %>


  </div>

  <div class="dash-side">
    <section class="panel actions p-actions" aria-labelledby="act-h">
      <div class="panel-head"><h2 id="act-h">What do you need to do?</h2></div>
      <div class="quick">
        <% if (can('parts.submit')) { %>
        <a href="/parts?action=take"><%- icon('take') %><span>Take parts</span></a>
        <a href="/parts?action=return"><%- icon('back') %><span>Return parts</span></a>
        <a href="/parts?action=request"><%- icon('request') %><span>Request parts</span></a>
        <% } %>
        <% if (can('training.submit')) { %>
        <a href="/training"><%- icon('training') %><span>Training request</span></a>
        <% } %>
        <% if (can('inspections.submit')) { %>
        <a href="/inspection"><%- icon('truck') %><span>Truck inspection</span></a>
        <% } %>
        <% if (can('forum.use')) { %>
        <a href="/discussions"><%- icon('talk') %><span>Discussions</span></a>
        <% } %>
        <a href="/people"><%- icon('people') %><span>People</span></a>
        <% if (can('complaints.submit')) { %>
        <a class="quiet" href="/complaint"><%- icon('complaint') %><span>Anonymous complaint</span></a>
        <% } %>
        <a class="quiet" href="/my"><%- icon('mine') %><span>My activity</span></a>
      </div>
    </section>

    <% if (dailyCard) { %>
    <section class="panel p-daily daily" aria-labelledby="daily-h" id="daily">
      <div class="panel-head"><h2 id="daily-h">Today's question</h2><a href="/daily">Earlier ones</a></div>
      <%- include('partials/daily_card', { d: dailyCard, back: 'home' }) %>
    </section>
    <% } %>

    <% if (upcoming.length) { %>
    <section class="panel p-up" aria-labelledby="up-h">
      <div class="panel-head"><h2 id="up-h">Coming up</h2><% if (can('training.submit')) { %><a href="/training/topics">Training topics</a><% } %></div>
      <ul class="agenda">
        <% upcoming.forEach(function (s) { %>
        <li>
          <span class="cal" aria-hidden="true"><span><%= s.month %></span><%= s.day %></span>
          <span class="agenda-body"><strong><%= s.title %></strong>
            <span class="meta"><%= s.weekday %>, <%= s.month %> <%= s.day %><%= s.time ? ' at ' + s.time : '' %><%= s.location ? ' · ' + s.location : '' %></span>
            <span class="meta"><%= s.when %></span></span>
        </li>
        <% }) %>
      </ul>
    </section>
    <% } %>

    <% if (status.length) { %>
    <section class="panel p-status" aria-labelledby="st-h">
      <div class="panel-head"><h2 id="st-h">My status</h2><a href="/my">My activity</a></div>
      <div class="mini-stats">
        <% status.forEach(function (s) { %>
        <a href="<%= s.url || '/my' %>" class="<%= s.warn ? 'warn' : '' %>"><span class="mini-label"><%= s.label %></span><span class="mini-num"><%= s.value %></span><span class="mini-sub"><%= s.sub %></span></a>
        <% }) %>
      </div>
    </section>
    <% } %>
  </div>
</div>
<p class="hint spaced"><a href="/account/password">Change my password</a></p>
<%- include('partials/footer') %>
