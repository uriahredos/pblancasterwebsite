<%- include('partials/header') %>
<%
  // Small line icons for the quick actions.
  var icons = {
    take: '<path d="M4 9.5 12 5l8 4.5v8L12 22l-8-4.5z"/><path d="M4 9.5 12 14l8-4.5M12 14v8"/><path d="M12 9V2m0 0L9.5 4.5M12 2l2.5 2.5"/>',
    back: '<path d="M4 9.5 12 5l8 4.5v8L12 22l-8-4.5z"/><path d="M4 9.5 12 14l8-4.5M12 14v8"/><path d="M12 2v7m0 0L9.5 6.5M12 9l2.5-2.5"/>',
    request: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1M12 9.5v6M9 12.5h6"/>',
    training: '<path d="M2.5 9 12 4.5 21.5 9 12 13.5z"/><path d="M6.5 11v4.5c1.6 1.5 3.4 2.2 5.5 2.2s3.9-.7 5.5-2.2V11M21.5 9v5.5"/>',
    truck: '<path d="M2.5 6.5h11v10h-11zM13.5 10h4l3 3v3.5h-7z"/><circle cx="7" cy="17.5" r="1.9"/><circle cx="17" cy="17.5" r="1.9"/>',
    complaint: '<path d="M4 5h16v11H10l-4.5 3.5V16H4z"/><path d="M8 9.5h8M8 12.5h5"/>',
    talk: '<path d="M3.5 5h11v8h-6l-3 2.5V13h-2z"/><path d="M17 9h3.5v8h-2v2.5l-3-2.5h-5v-2"/>',
    people: '<circle cx="9" cy="8.5" r="3.2"/><path d="M3 19.5c.6-3.2 2.9-5 6-5s5.4 1.8 6 5"/><circle cx="17" cy="9.5" r="2.4"/><path d="M16.5 14.6c2.4.2 4 1.7 4.5 4.4"/>',
    mine: '<path d="M9 6.5h11M9 12h11M9 17.5h11"/><path d="m3.5 6.5 1.2 1.2 2-2.4M3.5 12l1.2 1.2 2-2.4M3.5 17.5l1.2 1.2 2-2.4"/>'
  };
  var icon = function (name) { return '<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' + icons[name] + '</svg>'; };
%>
<div class="dash-hello hero">
  <div>
    <p class="hero-date"><%= dateLine %></p>
    <h1>Hi, <%= user.display_name.split(' ')[0] %></h1>
    <p class="hero-sub"><%= branchName ? branchName + ' Office' : 'Pye-Barker Fire & Safety' %></p>
  </div>
  <img class="hero-mark" src="/logo-flame.png?v=<%= assetV %>" alt="" width="422" height="208" aria-hidden="true">
  <span class="embers" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
</div>

<section class="company-strip" aria-label="The company at a glance">
  <div class="strip-stats">
    <% company.stats.forEach(function (st) { %><a href="<%= st.url %>"><strong><%= st.value.toLocaleString('en-US') %></strong><span><%= st.label %></span></a><% }) %>
  </div>
  <% if (company.spot) { %>
  <a class="strip-spot" href="/branches/<%= company.spot.id %>">
    <span class="eyebrow">Meet an office this week</span>
    <strong><%= company.spot.name %><%= company.spot.city && company.spot.state ? ' · ' + company.spot.city + ', ' + company.spot.state : '' %></strong>
    <span class="meta"><%= company.spot.services ? company.spot.services : company.spot.people ? company.spot.people + (company.spot.people === 1 ? ' person' : ' people') + ' on this site' : 'See what they do' %></span>
  </a>
  <% } %>
</section>

<% if (critical.length) { %>
<section class="critical" aria-label="Critical announcements">
<% critical.forEach(function (n) { %>
<div class="card critical-card">
  <div class="rec-head"><span class="tag crit">Critical</span><% if (!n.read_at) { %><span class="tag new">New</span><% } %><% if (n.category !== 'general') { %><span class="tag cat-<%= n.category %>"><%= categories[n.category] %></span><% } %><strong><%= n.title %></strong><time><%= n.author %>, <%= fmtDateTime(n.created_at) %></time></div>
  <p class="pre"><%= n.body %></p>
  <% if (!n.read_at) { %>
  <form method="post" action="/notices/<%= n.id %>/read"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="home"><button class="btn primary small" type="submit">I have read this</button></form>
  <% } else { %><p class="meta">You read this on <%= fmtDateTime(n.read_at) %><%= n.expires_on ? '. Showing until ' + fmtDate(n.expires_on) : '' %>.</p><% } %>
</div>
<% }) %>
</section>
<% } %>

<% if (!hasPasskey) { %>
<div class="card tip-card" id="passkey-tip" hidden>
  <p><strong>Get in with your face or fingerprint.</strong> The site now locks when you close it. Set up Face ID or fingerprint so you do not have to type your password each time.</p>
  <span class="tip-actions"><a class="btn primary small" href="/account/password#face-id">Set it up</a><button type="button" class="link" id="passkey-tip-no">Not now</button></span>
</div>
<% } %>

<% if (profileEmpty) { %>
<div class="card tip-card" id="profile-tip">
  <p><strong>Tell people who you are.</strong> Add a photo, your job and what you know about, so people across the company can put a face to your name.</p>
  <span class="tip-actions"><a class="btn primary small" href="/profile">Fill in my profile</a></span>
</div>
<% } %>

<% if (myCerts.length || replies.length) { %>
<section class="attention" aria-label="Needs your attention">
<% if (replies.length) { %>
<div class="card replies-card">
  <div class="rec-head"><span class="tag new">New replies</span><strong>In threads you follow</strong></div>
  <ul class="replies">
    <% replies.forEach(function (t) { %>
    <li><a href="/discussions/t/<%= t.id %>"><strong><%= t.last_author %></strong> replied in <strong><%= t.title %></strong></a><span class="meta"><%= fmtDateTime(t.last_post_at) %></span></li>
    <% }) %>
  </ul>
</div>
<% } %>
<% myCerts.forEach(function (c) { %>
<p class="flash <%= c.status === 'expired' ? 'err' : 'warn' %>"><strong><%= c.name %></strong> <%= c.status === 'expired' ? 'expired on ' + fmtDate(c.expires_on) : c.days === 0 ? 'expires today' : 'expires in ' + c.days + (c.days === 1 ? ' day' : ' days') + ', on ' + fmtDate(c.expires_on) %>. Tell your manager when it is renewed.</p>
<% }) %>
</section>
<% } %>

<div class="dash">
  <div class="dash-main">
    <section class="panel p-board" aria-labelledby="board-h">
      <div class="panel-head"><h2 id="board-h">Announcements</h2><a href="/notices">All announcements</a></div>
      <% notices.forEach(function (n) { %>
      <div class="notice-card unread-card cat-<%= n.category %>">
        <div class="rec-head"><span class="tag new">New</span><% if (n.category !== 'general') { %><span class="tag cat-<%= n.category %>"><%= categories[n.category] %></span><% } %><strong><%= n.title %></strong><time><%= n.author %>, <%= fmtDateTime(n.created_at) %></time></div>
        <p class="pre"><%= n.body %></p>
        <form method="post" action="/notices/<%= n.id %>/read"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="home"><button class="btn primary small" type="submit">I have read this</button></form>
      </div>
      <% }) %>
      <% if (!board.length && !notices.length) { %><p class="empty"><%= critical.length ? 'Nothing else posted right now.' : 'No announcements right now.' %></p><% } %>
      <ul class="board">
        <% board.forEach(function (n) { %>
        <li class="cat-<%= n.category %>">
          <a href="/notices#n<%= n.id %>">
            <span class="board-top"><% if (n.pinned) { %><span class="tag pin">Pinned</span><% } %><% if (n.category !== 'general') { %><span class="tag cat-<%= n.category %>"><%= categories[n.category] %></span><% } %><strong><%= n.title %></strong></span>
            <span class="board-body"><%= n.body %></span>
            <span class="board-meta"><%= n.author %> · <%= dateOnly(n.created_at) %></span>
          </a>
        </li>
        <% }) %>
      </ul>
    </section>
    <% if (issue && issueIsNew) { %>
    <section class="panel news p-news" aria-labelledby="news-h">
      <div class="panel-head"><h2 id="news-h">The Monthly Barker</h2><a href="/newsletters">All issues</a></div>
      <div class="issue">
        <a class="issue-cover" href="/newsletters/<%= issue.id %>" aria-label="Read the <%= issue.month %> newsletter">
          <% if (issue.pages.length) { %><img src="/newsletters/<%= issue.id %>/page/1" alt="" width="1100" height="1424"><% } else { %><span class="cover-blank"><span><%= issue.month.split(' ')[0] %></span><%= issue.month.split(' ')[1] %></span><% } %>
        </a>
        <div class="issue-body">
          <p class="eyebrow">New issue</p>
          <h3><%= issue.title %></h3>
          <% if (issue.highlightList.length) { %>
          <ul class="highlights"><% issue.highlightList.slice(0, 4).forEach(function (h) { %><li><%= h %></li><% }) %></ul>
          <% } else { %><p class="meta">Birthdays, anniversaries, office news and this month's spotlight.</p><% } %>
          <a class="btn primary" href="/newsletters/<%= issue.id %>">Read this issue</a>
        </div>
      </div>
    </section>
    <% } else if (issue) { %>
    <section class="panel slim p-news" aria-label="Newsletter">
      <div class="one-line"><p><strong>The Monthly Barker</strong> <span class="meta">· <%= issue.month %> · <a href="/newsletters">all issues</a></span></p><a class="btn small" href="/newsletters/<%= issue.id %>">Read</a></div>
    </section>
    <% } else if (can('newsletters.manage')) { %>
    <section class="panel slim p-news" aria-label="Newsletter">
      <div class="one-line"><p><strong>The Monthly Barker</strong> <span class="meta">· nothing posted yet</span></p><a class="btn small" href="/admin/newsletters">Upload the first one</a></div>
    </section>
    <% } %>
    <% if (shouts.length) { %>
    <section class="panel p-shouts" aria-labelledby="shouts-h" id="shoutouts">
      <div class="panel-head"><h2 id="shouts-h">Shout-outs</h2><a href="/shoutouts">All shout-outs</a></div>
      <ul class="shouts"><% shouts.forEach(function (s) { %><%- include('partials/shout', { s: s, back: 'home' }) %><% }) %></ul>
      <p class="panel-foot"><a class="btn small" href="/shoutouts#give">👏 Give a shout-out</a></p>
    </section>
    <% } else { %>
    <section class="panel slim p-shouts" aria-label="Shout-outs" id="shoutouts">
      <div class="one-line"><p><strong>Shout-outs</strong> <span class="meta">· who did a great job this week?</span></p><a class="btn small" href="/shoutouts#give">👏 Give a shout-out</a></div>
    </section>
    <% } %>
    <section class="panel p-around" aria-labelledby="around-h">
      <div class="panel-head"><h2 id="around-h">Around the company</h2><a href="/people">People</a></div>
      <% if (!around.length) { %>
      <div class="one-line"><p class="empty">Quiet so far. Be the first: add a photo or start a discussion.</p><span class="filter-actions"><a class="btn small" href="/photos">Add a photo</a><% if (can('forum.use')) { %><a class="btn small" href="/discussions/new">Start a discussion</a><% } %></span></div>
      <% } else { %>
      <ul class="feed">
        <% var firstHire = true; around.forEach(function (i) { %>
        <li class="feed-<%= i.kind %>" <%- i.kind === 'hire' && firstHire ? 'id="welcome"' : '' %>><% if (i.kind === 'hire') firstHire = false; %>
          <a class="feed-who" href="/people/<%= i.who.user_id %>"><%- include('partials/avatar', { who: { id: i.who.user_id, display_name: i.who.display_name, photo_path: i.who.photo_path } }) %></a>
          <div class="feed-body">
            <p class="feed-title"><a href="<%= i.url %>"><strong><%= i.title %></strong></a></p>
            <% if (i.text) { %><p class="feed-text"><%= i.text %></p><% } %>
            <% if (i.photo) { %><a class="feed-photo" href="/wall/photo/<%= i.photo %>"><img src="/wall/photo/<%= i.photo %>" alt="<%= i.text || 'Photo from ' + i.who.display_name %>" loading="lazy"></a><% } %>
            <p class="feed-meta"><% if (i.who.office) { %><span class="pill <%= i.away ? 'away' : '' %>"><%= i.who.office %> office</span> <% } %><span><%= i.when %></span><% if (i.extra) { %> · <span><%= i.extra %></span><% } %><% if (i.done) { %> · <span><%= i.done %></span><% } %></p>
          </div>
          <% if (i.link) { %><a class="btn small" href="<%= i.link.url %>"><%= i.link.label %></a><% } %>
          <% if (i.action) { %><form method="post" action="<%= i.action.url %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="home"><button class="btn primary small" type="submit"><%= i.action.label %></button></form><% } %>
        </li>
        <% }) %>
      </ul>
      <p class="panel-foot filter-actions"><a class="btn small" href="/photos">Add a photo</a><% if (can('forum.use')) { %><a class="btn small" href="/discussions/new">Start a discussion</a><% } %><a class="btn small" href="/events">Events</a></p>
      <% } %>
    </section>
  </div>

  <div class="dash-side">
    <% if (onCall.length) { %>
    <section class="panel p-oncall" aria-labelledby="oncall-h">
      <div class="panel-head"><h2 id="oncall-h">On call now</h2><a href="/oncall">Schedule</a></div>
      <ul class="oncall-people compact">
        <% onCall.forEach(function (p) { %>
        <li class="role-<%= p.role %>"><span class="oncall-who"><span class="tag <%= p.role === 'tech' ? 'new' : '' %>"><%= p.role === 'tech' ? 'On call' : 'Backup' %></span><strong><%= p.name %></strong></span><% if (p.phone) { %><a class="btn small <%= p.role === 'tech' ? 'primary' : '' %>" href="tel:<%= p.tel %>" data-full>Call</a><% } %></li>
        <% }) %>
      </ul>
    </section>
    <% } %>
    <% if (thisWeek.length || upcoming.length) { %>
    <section class="panel p-up" aria-labelledby="up-h" id="thisweek">
      <div class="panel-head"><h2 id="up-h">Coming up</h2><a href="/events">Events</a></div>
      <% if (thisWeek.length) { %>
      <h3 class="sub-h">Birthdays and anniversaries</h3>
      <ul class="week">
        <% thisWeek.forEach(function (o) { %>
        <li class="<%= o.today ? 'today' : '' %>">
          <a href="/people/<%= o.id %>"><%- include('partials/avatar', { who: o }) %></a>
          <span class="person-text"><strong><%= o.kind === 'birthday' ? '🎂' : '🎉' %> <a href="/people/<%= o.id %>"><%= o.mine ? 'You' : o.display_name %></a></strong>
            <span class="meta"><%= o.text %> · <%= o.when %><%= o.branch_id !== user.branch_id && o.branch ? ' · ' + o.branch : '' %><%= o.wishes ? ' · ' + o.wishes + (o.wishes === 1 ? ' wish' : ' wishes') : '' %></span></span>
          <% if (!o.mine && !o.wished) { %><form method="post" action="/celebrate"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="user_id" value="<%= o.id %>"><input type="hidden" name="kind" value="<%= o.kind %>"><button class="btn small" type="submit"><%= o.kind === 'birthday' ? 'Happy birthday' : 'Congrats' %></button></form>
          <% } else if (o.wished) { %><span class="meta">Sent ✓</span><% } %>
        </li>
        <% }) %>
      </ul>
      <% } %>
      <% if (upcoming.length) { %>
      <% if (thisWeek.length) { %><h3 class="sub-h">Events and training</h3><% } %>
      <ul class="agenda">
        <% upcoming.forEach(function (s) { %>
        <li>
          <span class="cal" aria-hidden="true"><span><%= s.month %></span><%= s.day %></span>
          <span class="agenda-body"><strong><% if (s.url) { %><a href="<%= s.url %>"><%= s.title %></a><% } else { %><%= s.title %><% } %></strong>
            <span class="meta"><%= s.weekday %>, <%= s.month %> <%= s.day %><%= s.time ? ' at ' + s.time : '' %><%= s.location ? ' · ' + s.location : '' %></span>
            <span class="meta"><%= s.when %> · <%= s.kind %></span></span>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </section>
    <% } %>
    <% if (myTasks.length) { %>
    <section class="panel p-tasks" aria-labelledby="tasks-h">
      <div class="panel-head"><h2 id="tasks-h">Your tasks</h2><a href="/tasks">All tasks</a></div>
      <ul class="todo">
        <% myTasks.forEach(function (t) { %>
        <li class="<%= t.overdue ? 'overdue' : t.days !== null && t.days <= 1 ? 'soon' : '' %>"><a href="/tasks#t<%= t.id %>"><strong><%= t.title %></strong><span class="todo-when"><%= t.when %> · from <%= t.by_name %></span></a></li>
        <% }) %>
      </ul>
      <% if (badges.tasks > myTasks.length) { %><p class="panel-foot"><a href="/tasks">and <%= badges.tasks - myTasks.length %> more</a></p><% } %>
    </section>
    <% } %>
    <section class="panel branch-panel p-glance" aria-labelledby="branch-h">
      <div class="panel-head"><h2 id="branch-h"><%= branchTitle %></h2><% if (officeId) { %><a href="/branches/<%= officeId %>">Office page</a><% } %></div>
      <div class="branch-stats">
        <% branch.forEach(function (s) { %>
        <a href="<%= s.url %>" class="<%= s.level %>"><span class="mini-num"><%= s.value %></span><span class="mini-label"><%= s.label %></span><span class="mini-sub"><%= s.sub %></span></a>
        <% }) %>
      </div>
      <% if (mine.length) { %>
      <h3 class="sub-h">Yours <a href="/my">My activity</a></h3>
      <div class="branch-stats">
        <% mine.forEach(function (t) { %>
        <a href="<%= t.url || '/my' %>" class="<%= t.warn ? 'warn' : '' %>"><span class="mini-num"><%= t.value %></span><span class="mini-label"><%= t.label %></span><span class="mini-sub"><%= t.sub %></span></a>
        <% }) %>
      </div>
      <% } %>
    </section>
    <section class="panel actions p-actions" aria-labelledby="act-h">
      <div class="panel-head"><h2 id="act-h">What do you need to do?</h2></div>
      <div class="quick">
        <% if (can('parts.submit')) { %>
        <a href="/parts?action=take"><%- icon('take') %><span>Take parts</span></a>
        <a href="/parts?action=return"><%- icon('back') %><span>Return parts</span></a>
        <a href="/parts?action=request"><%- icon('request') %><span>Request parts</span></a>
        <% } %>
        <% if (can('training.submit')) { %>
        <a href="/training"><%- icon('training') %><span>Training request</span></a>
        <% } %>
        <% if (can('inspections.submit')) { %>
        <a href="/inspection"><%- icon('truck') %><span>Truck inspection</span></a>
        <% } %>
        <% if (can('sales.use')) { %>
        <a href="/sales"><%- icon('request') %><span>Sales leads</span></a>
        <% } %>
        <% if (can('forum.use')) { %>
        <a href="/discussions"><%- icon('talk') %><span>Discussions</span></a>
        <% } %>
        <a href="/oncall"><%- icon('talk') %><span>On call</span></a>
        <a href="/people"><%- icon('people') %><span>People</span></a>
        <% if (can('complaints.submit')) { %>
        <a class="quiet" href="/complaint"><%- icon('complaint') %><span>Anonymous complaint</span></a>
        <% } %>
        <a class="quiet" href="/my"><%- icon('mine') %><span>My activity</span></a>
      </div>
    </section>

    <% if (dailyCard) { %>
    <section class="panel p-daily daily" aria-labelledby="daily-h" id="daily">
      <div class="panel-head"><h2 id="daily-h">Today's question</h2><a href="/daily">Earlier ones</a></div>
      <%- include('partials/daily_card', { d: dailyCard, back: 'home' }) %>
    </section>
    <% } %>

  </div>
</div>
<%- include('partials/footer') %>
