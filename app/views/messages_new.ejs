<%- include('partials/header') %>
<p class="back"><a class="back-link" href="/messages">Messages</a></p>
<h1>Message <%= other.display_name %></h1>
<p class="lede">This is private: only you and <%= other.display_name %> can read it.</p>
<%- include('partials/errors') %>
<form method="post" action="/messages/with/<%= other.id %>" class="card stack" data-once>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label><span class="sr">Your message</span><textarea name="body" rows="5" maxlength="4000" required autofocus placeholder="Write your message"><%= values.body || '' %></textarea></label>
  <button class="btn primary" type="submit">Send</button>
</form>
<%- include('partials/footer') %>
