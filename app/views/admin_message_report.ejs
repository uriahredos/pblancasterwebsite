<%- include('partials/header') %>
<p class="back"><a class="back-link" href="/admin/message-reports">Reported messages</a></p>
<h1>Reported conversation</h1>
<p class="lede"><%= r.name_a %> and <%= r.name_b %>. Reported by <strong><%= r.reporter %></strong> on <%= fmtDateTime(r.created_at) %>.<% if (r.note) { %> They wrote: <em><%= r.note %></em><% } %> <%= r.closed_at ? 'This report is closed, so the conversation can no longer be read here.' : 'You are shown the conversation as it stood when it was reported, and nothing written since. Opening this was recorded.' %></p>
<div class="dm dm-review">
  <% rows.forEach(function (m) { %>
  <% if (m.kind === 'call') { %><article class="dm-note"><p class="meta"><%= m.author %> made a <%= m.body.toLowerCase() %> · <%= fmtDateTime(m.created_at) %></p></article><% return; } %>
  <article class="dm-msg <%= m.user_id === r.reported_by ? 'mine' : 'theirs' %> <%= m.id === r.message_id ? 'is-new' : '' %>" id="m<%= m.id %>">
    <div class="dm-bubble"><p class="meta"><strong><%= m.author %></strong><%= m.id === r.message_id ? ' · reported message' : '' %></p>
      <div class="msg-body"><%- fmt(m.body) %></div><% if (m.removed_at) { %><p class="meta removed-msg">The sender removed this message on <%= fmtDateTime(m.removed_at) %>.</p><% } %>
      <p class="meta dm-time"><%= fmtDateTime(m.created_at) %></p></div>
  </article>
  <% }) %>
</div>
<% if (!r.closed_at) { %>
<form method="post" action="/admin/message-reports/<%= r.id %>/close" class="card stack" data-once>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>What was done <span class="hint">Optional. Kept with the report.</span><textarea name="outcome" rows="3" maxlength="500"></textarea></label>
  <button class="btn primary" type="submit">Close this report</button>
</form>
<% } else { %><p class="meta">Closed <%= fmtDateTime(r.closed_at) %><%= r.outcome ? ': ' + r.outcome : '' %></p><% } %>
<%- include('partials/footer') %>
