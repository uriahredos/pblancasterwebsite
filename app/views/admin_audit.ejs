<%- include('partials/header', { wide: true }) %>
<div class="title-row">
  <h1>Parts audit</h1>
  <span class="filter-actions no-print">
    <button type="button" class="btn small" data-print>Print</button>
    <a class="btn small" href="/admin/parts/audit.csv?<%= qs %>">Download CSV</a>
  </span>
</div>
<p class="lede"><strong><%= fmtDate(f.from) %> to <%= fmtDate(f.to) %></strong><% if (f.user) { var who = users.find(function (u) { return String(u.id) === f.user; }); %> · <%= who ? who.display_name : '' %><% } %><% if (f.show) { %> · unchecked only<% } %>. Every part taken, returned and requested in these dates. Tick an entry once you have checked it against the shelf or the paperwork.</p>

<form method="get" class="filters card no-print">
  <label>From <input type="date" name="from" value="<%= f.from %>" required></label>
  <label>To <input type="date" name="to" value="<%= f.to %>" required></label>
  <label>Person
    <select name="user"><option value="">Everyone</option>
      <% users.forEach(function (u) { %><option value="<%= u.id %>" <%= String(u.id) === f.user ? 'selected' : '' %>><%= u.display_name %></option><% }) %>
    </select>
  </label>
  <label>Show
    <select name="show"><option value="">All entries</option><option value="unchecked" <%= f.show ? 'selected' : '' %>>Not checked yet</option></select>
  </label>
  <div class="filter-actions"><button class="btn primary small" type="submit">Show</button></div>
  <div class="presets">
    <% presets.forEach(function (p) { %><a href="/admin/parts/audit?from=<%= p[1] %>&amp;to=<%= p[2] %><%= f.user ? '&user=' + f.user : '' %><%= f.show ? '&show=' + f.show : '' %>" <%- p[1] === f.from && p[2] === f.to ? 'aria-current="true"' : '' %>><%= p[0] %></a><% }) %>
  </div>
</form>

<div class="stats">
  <% [['take', 'Taken'], ['return', 'Returned'], ['request', 'Requested']].forEach(function (a) { var sec = sections[a[0]]; %>
  <a class="stat <%= a[0] %>" href="#<%= a[0] %>">
    <span class="stat-label"><%= a[1] %></span>
    <span class="stat-num"><%= sec.quantity %></span>
    <span class="stat-sub">units in <%= sec.count %> <%= sec.count === 1 ? 'entry' : 'entries' %> · <%= sec.checked %> of <%= sec.count %> checked</span>
  </a>
  <% }) %>
</div>

<% [['take', 'Taken'], ['return', 'Returned'], ['request', 'Requested']].forEach(function (a) { var sec = sections[a[0]]; var isReq = a[0] === 'request'; %>
<section id="<%= a[0] %>" class="audit-section">
  <div class="title-row">
    <h2><%= a[1] %> <span class="hint"><%= sec.quantity %> units · <%= sec.lines %> <%= sec.lines === 1 ? 'line' : 'lines' %> · <%= sec.count %> <%= sec.count === 1 ? 'entry' : 'entries' %><% if (sec.cancelled) { %> · <%= sec.cancelled %> cancelled, not counted<% } %></span></h2>
    <% if (sec.count > sec.checked) { %>
    <form method="post" action="/admin/parts/audit/check-all" class="no-print" data-confirm="Mark all <%= sec.count - sec.checked %> unchecked '<%= a[1].toLowerCase() %>' entries in this range as checked?">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="qs" value="<%= qs %>"><input type="hidden" name="action" value="<%= a[0] %>">
      <button class="btn small" type="submit">Mark all as checked</button>
    </form>
    <% } %>
  </div>
  <div class="table-wrap">
  <table class="audit">
    <thead><tr><th>Submitted</th><th>Name</th><th>Part</th><th>Description</th><th class="num">Qty</th><th>For</th><% if (isReq) { %><th>Needed by</th><th>Status</th><% } %><th>Checked</th></tr></thead>
    <tbody>
    <% sec.entries.forEach(function (e) { e.items.forEach(function (it, i) { %>
    <tr class="<%= e.cancelled_at ? 'off' : '' %> <%= i === 0 ? 'entry-start' : '' %>" <%- i === 0 ? 'id="e' + e.id + '"' : '' %>>
      <% if (i === 0) { %>
      <td class="nowrap" rowspan="<%= e.items.length %>"><a href="/admin/parts/<%= e.id %>"><%= fmtDateTime(e.created_at) %></a><% if (e.edited_at) { %><br><span class="hint">edited</span><% } %></td>
      <td rowspan="<%= e.items.length %>"><%= e.display_name %></td>
      <% } %>
      <td class="items"><%= it.part_name %></td>
      <td><%= it.description %></td>
      <td class="num"><%= it.quantity %></td>
      <% if (i === 0) { %>
      <td rowspan="<%= e.items.length %>"><%= e.source === 'job' ? 'Job ' + e.job_number : 'Van stock' %><% if (e.note) { %><br><span class="hint"><%= e.note %></span><% } %></td>
      <% if (isReq) { %>
      <td class="nowrap" rowspan="<%= e.items.length %>"><%= fmtDate(e.needed_by) %></td>
      <td rowspan="<%= e.items.length %>"><% if (!e.cancelled_at && e.status) { %><span class="status s-<%= e.status %>"><%= labels.partsStatus[e.status] %></span><% } %></td>
      <% } %>
      <td rowspan="<%= e.items.length %>" class="check-cell">
        <% if (e.cancelled_at) { %><span class="tag off">Cancelled</span>
        <% } else { %>
        <form method="post" action="/admin/parts/<%= e.id %>/audit">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="qs" value="<%= qs %>">
          <button type="submit" class="check <%= e.audited_at ? 'on' : '' %>" aria-pressed="<%= e.audited_at ? 'true' : 'false' %>" title="<%= e.audited_at ? 'Checked. Click to undo.' : 'Mark as checked' %>"><span class="box" aria-hidden="true"><%= e.audited_at ? '✓' : '' %></span><span class="sr"><%= e.audited_at ? 'Checked' : 'Not checked' %></span></button>
        </form>
        <% if (e.audited_at) { %><span class="hint"><%= e.audited_by_name %><br><%= fmtDateTime(e.audited_at) %></span><% } %>
        <% } %>
      </td>
      <% } %>
    </tr>
    <% }) }) %>
    <% if (!sec.entries.length) { %><tr><td colspan="<%= isReq ? 9 : 7 %>" class="empty">Nothing <%= a[1].toLowerCase() %> in these dates.</td></tr><% } %>
    </tbody>
    <% if (sec.entries.length) { %>
    <tfoot><tr><td colspan="4">Total <%= a[1].toLowerCase() %></td><td class="num"><%= sec.quantity %></td><td colspan="<%= isReq ? 4 : 2 %>"></td></tr></tfoot>
    <% } %>
  </table>
  </div>
</section>
<% }) %>
<%- include('partials/footer') %>
