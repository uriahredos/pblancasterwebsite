<%- include('partials/header') %>
<h1>Branches</h1>
<p class="lede">Each person belongs to one branch. People, profiles, discussions, the daily question and newsletters are shared by everyone. Parts, stock, trucks, tasks, training, certifications, announcements and complaints stay inside each branch.</p>
<%- include('partials/errors') %>
<ul class="records">
  <% rows.forEach(function (b) { %>
  <li class="card">
    <div class="rec-head"><strong><%= b.name %></strong><time><%= b.people %> <%= b.people === 1 ? 'person' : 'people' %><%= b.off ? ', ' + b.off + ' without sign-in' : '' %></time></div>
    <form method="post" action="/admin/branches/<%= b.id %>" class="filters">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="grow"><span class="sr">Name</span><input name="name" value="<%= b.name %>" maxlength="60" required autocomplete="off"></label>
      <div class="filter-actions"><button class="btn small" type="submit">Rename</button><a class="btn small" href="/people?branch=<%= b.id %>">See its people</a></div>
    </form>
  </li>
  <% }) %>
</ul>
<h2>Add a branch</h2>
<form method="post" action="/admin/branches" class="card stack">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Name <span class="hint">Usually the town, for example Harrisburg.</span><input name="name" value="<%= values.name || '' %>" maxlength="60" required autocomplete="off"></label>
  <button class="btn primary" type="submit">Add branch</button>
</form>
<div class="notice">
  <p><strong>Who sees what</strong></p>
  <p>You can see every branch. Use the branch box in the menu to choose which one the logs, stock and other pages show, or "All branches" to see them together.</p>
  <p>Everyone else sees only their own branch, whatever their profile. To let someone else see every branch, tick "See and manage every branch" on their profile.</p>
</div>
<%- include('partials/footer') %>
