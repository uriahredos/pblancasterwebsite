<%- include('partials/header') %>
<p class="back"><a class="back-link" href="/admin/profiles">Profiles</a></p>
<h1><%= profile.name %> profile</h1>
<p class="lede"><% if (people.length) { %>Used by <%= people.map(function (p) { return p.display_name; }).join(', ') %>.<% } else { %>Nobody has this profile yet.<% } %> Changes apply as soon as you save.</p>
<%- include('partials/errors') %>
<form method="post" action="/admin/profiles/<%= profile.id %>" class="card stack">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Name
    <input name="name" value="<%= values.name %>" required maxlength="40" autocomplete="off">
  </label>

  <fieldset>
    <legend>Level: how far does this profile reach?</legend>
    <p class="hint">The boxes below say what they can do; this says for whom. With <strong>Add and edit people</strong> ticked they are an admin at that level. With <strong>Assign tasks</strong> but not that, a manager.</p>
    <% levels.forEach(function (l) { %>
    <label class="choice <%= l.locked ? 'locked' : '' %>"><input type="radio" name="level" value="<%= l.key %>" <%= level === l.key ? 'checked' : '' %> <%= l.locked && level !== l.key ? 'disabled' : '' %>>
      <span><strong><%= l.label %></strong> <span class="hint"><%= l.hint %><% if (l.locked) { %> (you do not reach this far yourself, so you cannot choose it)<% } %></span></span></label>
    <% }) %>
  </fieldset>

  <% groups.forEach(function (g) { %>
  <fieldset>
    <legend><%= g.title %></legend>
    <% g.items.forEach(function (item) { var locked = !can(item[0]); %>
    <label class="choice <%= locked ? 'locked' : '' %>">
      <input type="checkbox" name="perms" value="<%= item[0] %>" <%= held.has(item[0]) ? 'checked' : '' %> <%= locked ? 'disabled' : '' %>>
      <span><%= item[1] %><% if (locked) { %> <span class="hint">(you do not have this yourself, so you cannot change it)</span><% } %></span>
    </label>
    <% }) %>
  </fieldset>
  <% }) %>
  <button class="btn primary" type="submit">Save profile</button>
</form>
<%- include('partials/footer') %>
