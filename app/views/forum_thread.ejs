<%- include('partials/header') %>
<p class="back"><a class="back-link" href="/discussions/s/<%= t.section_id %>"><%= t.section %></a></p>
<h1 class="thread-title"><%= t.title %></h1>
<p class="thread-tags"><% if (t.is_pinned) { %><span class="tag pin">Pinned</span> <% } %><% if (t.solved_at) { %><span class="tag solved">Solved</span> <% } %><% if (t.is_locked) { %><span class="tag off">Locked</span> <% } %><span class="meta"><%= t.reply_count %> <%= t.reply_count === 1 ? 'reply' : 'replies' %></span></p>
<div class="thread-tools">
  <form method="post" action="/discussions/t/<%= t.id %>/follow"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="follow" value="<%= following ? '0' : '1' %>"><button class="btn small" type="submit"><%= following ? 'Following · stop' : 'Follow this thread' %></button></form>
  <% if (t.kind === 'support' && (owner || mod)) { %>
  <form method="post" action="/discussions/t/<%= t.id %>/solved"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small" type="submit"><%= t.solved_at ? 'Not solved after all' : 'Mark as solved' %></button></form>
  <% } %>
  <% if (owner || mod) { %>
  <details class="rename"><summary class="btn small">Rename</summary>
    <form method="post" action="/discussions/t/<%= t.id %>/rename" class="filters" data-no-live><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="grow"><span class="sr">Title</span><input name="title" value="<%= t.title %>" maxlength="140" required autocomplete="off"></label><div class="filter-actions"><button class="btn primary small" type="submit">Save title</button></div></form></details>
  <% } %>
  <% if (mod || (owner && t.reply_count === 0)) { %>
  <form method="post" action="/discussions/t/<%= t.id %>/delete" data-confirm="Remove this whole thread? This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link danger" type="submit">Remove thread</button></form>
  <% } %>
</div>
<% if (mod) { %>
<details class="mod-tools">
  <summary>Moderator tools</summary>
  <div class="thread-tools">
    <form method="post" action="/discussions/t/<%= t.id %>/pin"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small" type="submit"><%= t.is_pinned ? 'Unpin' : 'Pin to the top of its section' %></button></form>
    <form method="post" action="/discussions/t/<%= t.id %>/lock"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small" type="submit"><%= t.is_locked ? 'Unlock' : 'Lock (no more replies)' %></button></form>
    <form method="post" action="/discussions/t/<%= t.id %>/move" class="move"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Move to <select name="section_id"><% sections.forEach(function (s) { %><option value="<%= s.id %>" <%= s.id === t.section_id ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label>
      <button class="btn small" type="submit">Move</button></form>
  </div>
</details>
<% } %>

<% if (t.kind === 'support') { %>
<section class="call" data-call-root data-thread="<%= t.id %>" aria-label="Video call">
  <div class="call-banner" data-call-banner>
    <% if (!call) { %>
    <button class="btn small" type="button" data-call-start>Start a video call</button>
    <span class="meta">Show the problem live to someone who can help. Nothing is recorded.</span>
    <% } else if (call.mineHost) { %>
    <span class="call-dot" aria-hidden="true"></span><strong>Your video call is open</strong>
    <button class="btn small" type="button" data-call-start>Resume</button>
    <% } else if (call.mineGuest) { %>
    <span class="call-dot" aria-hidden="true"></span><strong>You are in <%= call.hostName %>'s call</strong>
    <button class="btn small" type="button" data-call-join>Rejoin</button>
    <% } else if (call.full) { %>
    <span class="call-dot" aria-hidden="true"></span><span><strong><%= call.hostName %></strong> is on a video call with someone. It is full.</span>
    <% } else { %>
    <span class="call-dot" aria-hidden="true"></span><span><strong><%= call.hostName %></strong> is on a live video call.</span>
    <button class="btn primary small" type="button" data-call-join>Join</button>
    <% } %>
  </div>
  <p class="call-note meta" data-call-note role="status" hidden></p>
  <div class="call-panel" data-call-panel hidden>
    <div class="call-stage">
      <video class="call-remote" data-call-remote autoplay playsinline></video>
      <video class="call-local" data-call-local autoplay playsinline muted></video>
    </div>
    <p class="call-status" data-call-status role="status"></p>
    <div class="call-controls">
      <button class="btn small" type="button" data-call-mute aria-pressed="false">Mute</button>
      <button class="btn small" type="button" data-call-camera aria-pressed="false">Camera off</button>
      <button class="btn small" type="button" data-call-flip>Flip camera</button>
      <button class="btn small danger" type="button" data-call-end>End call</button>
    </div>
  </div>
</section>
<% } %>
<div class="posts" data-live-thread="<%= t.id %>">
  <% posts.forEach(function (p) { %>
  <article class="post <%= p.first ? 'first' : '' %> <%= p.isNew ? 'is-new' : '' %>" id="p<%= p.id %>" data-rev="<%= (p.edited_at || '') + '|' + (p.removed_at || '') %>">
    <header class="post-head">
      <%- include('partials/avatar', { who: { id: p.user_id, display_name: p.author, photo_path: p.author_photo } }) %>
      <span class="post-who"><% if (p.author_gone) { %><strong><%= p.author %></strong><% } else { %><a href="/people/<%= p.user_id %>"><strong><%= p.author %></strong></a><% } %><% if (p.author_title) { %><span class="meta"><%= p.author_title %></span><% } %></span>
      <% if (p.user_id === t.user_id && !p.first) { %><span class="pill">Started the thread</span><% } %>
      <% if (p.isNew) { %><span class="tag new">New</span><% } %>
      <a class="post-link" href="#p<%= p.id %>" title="Link to this message"><time><%= fmtDateTime(p.created_at) %></time></a>
    </header>
    <% if (p.removed_at) { %><p class="meta removed-msg">Removed by the author.</p><% } else { %><div class="msg-body"><%- fmt(p.body) %></div><% } %>
    <% if (p.edited_at) { %><p class="meta edited">Edited <%= fmtDateTime(p.edited_at) %></p><% } %>
    <% if (p.photos.length) { %>
    <div class="photo-grid"><% p.photos.forEach(function (ph) { %><a href="/discussions/photo/<%= ph.id %>"><img src="/discussions/photo/<%= ph.id %>" alt="Photo from <%= p.author %>" loading="lazy"></a><% }) %></div>
    <% } %>
    <%- include('partials/reactions', { kind: 'post', item: p }) %>
    <% var mine = p.user_id === user.id, canEdit = mine && !p.removed_at && (!t.is_locked || anyMod), canQuote = !t.is_locked && !p.removed_at, blank = p.first && mine && t.reply_count > 0 && !p.removed_at, canDrop = p.canRemove, dropThread = p.first && mine && t.reply_count === 0; if (canEdit || canDrop || dropThread || blank || canQuote) { %>
    <div class="post-foot"><details class="msg-more"><summary aria-label="Edit or remove this message" title="Edit or remove">⋯</summary><div class="msg-tools">
      <% if (canQuote) { %><form onsubmit="return false"><textarea id="src<%= p.id %>" hidden readonly><%= p.body %></textarea><button class="link" type="button" data-quote="src<%= p.id %>" data-author="<%= p.author %>">Quote in a reply</button></form><% } %>
      <% if (canEdit) { %><details class="msg-edit"><summary class="link">Edit</summary>
        <form method="post" action="/discussions/p/<%= p.id %>/edit" class="stack" data-no-live><input type="hidden" name="_csrf" value="<%= csrf %>">
          <%- include('partials/format_bar') %>
          <label><span class="sr">Your message</span><textarea name="body" rows="4" maxlength="6000" required><%= p.body %></textarea></label>
          <div class="filter-actions"><button class="btn primary small" type="submit">Save</button></div></form></details><% } %>
      <% if (canDrop) { %><form method="post" action="/discussions/p/<%= p.id %>/delete" data-confirm="<%= mine ? 'Remove this reply?' : 'Remove this reply from ' + p.author + '?' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link danger" type="submit">Remove<%= mine ? '' : ' (admin)' %></button></form><% } %>
      <% if (blank) { %><form method="post" action="/discussions/p/<%= p.id %>/delete" data-confirm="Remove your message? Its words and photos go; the thread and the replies stay."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link danger" type="submit">Remove</button></form><% } %>
      <% if (dropThread) { %><form method="post" action="/discussions/t/<%= t.id %>/delete" data-confirm="Remove this message? Nobody has replied, so the thread goes with it."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link danger" type="submit">Remove</button></form><% } %>
    </div></details></div>
    <% } %>
  </article>
  <% }) %>
</div>

<% if (t.is_locked) { %>
<p class="flash warn">This thread is locked, so it cannot take new replies.</p>
<% } else { %>
<h2 id="reply">Reply</h2>
<%- include('partials/errors') %>
<form method="post" action="/discussions/t/<%= t.id %>/reply" enctype="multipart/form-data" class="card stack" data-once data-reply>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div><span class="label-line"><strong>Your reply</strong> <%- include('partials/format_bar') %></span>
    <label><span class="sr">Your reply</span><textarea name="body" rows="5" maxlength="6000" required><%= values.body || '' %></textarea></label>
  </div>
  <label>Photos <span class="hint">Optional, up to <%= maxPhotos %>. Do not post customer names, addresses or codes.</span>
    <input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/gif" multiple data-shrink="1600">
  </label>
  <button class="btn primary" type="submit">Post reply</button>
  <p class="hint">Replying follows the thread, so you will see later replies on your home page.</p>
</form>
<% } %>
<script src="/format.js?v=<%= assetV %>"></script>
<script src="/live.js?v=<%= assetV %>" defer></script>
<% if (t.kind === 'support') { %><script src="/call.js?v=<%= assetV %>" defer></script><% } %>
<script src="/shrink.js?v=<%= assetV %>" defer></script>
<%- include('partials/footer') %>
