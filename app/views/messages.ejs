<%- include('partials/header') %>
<h1>Messages</h1>
<p class="lede">Private messages between you and one other person. Only the two of you can read a conversation. If someone sends you something that is not right, use Report on that message.</p>
<form method="get" action="/messages" class="filters">
  <label class="grow">Start a conversation <input type="search" name="q" value="<%= q %>" maxlength="60" placeholder="Type a name" autocomplete="off"></label>
  <button class="btn" type="submit">Find</button>
</form>
<% if (q) { %>
<h2>People named "<%= q %>"</h2>
<% if (!found.length) { %><p class="empty">Nobody found. Try fewer letters.</p><% } else { %>
<ul class="roster"><% found.forEach(function (p) { %><li><a href="/messages/with/<%= p.id %>"><%- include('partials/avatar', { who: p }) %><span class="person-text"><strong><%= p.display_name %></strong><span class="meta"><%= [p.job_title, p.branch].filter(Boolean).join(' · ') %></span></span></a></li><% }) %></ul>
<% } %>
<% } %>
<h2>Conversations</h2>
<div data-live-inbox="<%= me %>">
<% if (!threads.length) { %><p class="empty">No conversations yet. Find someone above, or open their profile and tap Message.</p><% } else { %>
<ul class="dm-list">
  <% threads.forEach(function (t) { %>
  <li class="<%= t.unread ? 'unread' : '' %>">
    <a href="/messages/c/<%= t.id %>">
      <%- include('partials/avatar', { who: { id: t.other_id, display_name: t.other_name, photo_path: t.other_photo } }) %>
      <span class="dm-text"><span class="dm-top"><strong><%= t.other_name %></strong><% if (t.unread) { %> <span class="tag new">New</span><% } %><span class="meta dm-when"><%= dateOnly(t.last_at) %></span></span>
        <span class="meta dm-snip"><%= t.last_from === me ? 'You: ' : '' %><%= t.last_removed ? 'Message removed' : String(t.last_body).replace(/\s+/g, ' ').slice(0, 90) %></span></span>
    </a>
  </li>
  <% }) %>
</ul>
<% } %>
</div>
<script src="/live.js?v=<%= assetV %>" defer></script>
<%- include('partials/footer') %>
