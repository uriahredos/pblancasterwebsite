<%- include('partials/header') %>
<h1>My activity</h1>

<h2>Parts</h2>
<% if (!parts.length) { %><p class="empty">Nothing yet. <a href="/parts">Open the parts form</a>.</p><% } %>
<ul class="records">
<% parts.forEach(function (s) { %>
  <li class="card <%= s.cancelled_at ? 'cancelled' : '' %>">
    <div class="rec-head">
      <span class="tag <%= s.action %>"><%= labels.action[s.action] %></span>
      <% if (s.unseen) { %><span class="tag new">Updated</span><% } %>
      <% if (s.cancelled_at) { %><span class="tag off">Cancelled</span><% } else if (s.status) { %><span class="status s-<%= s.status %>"><%= labels.partsStatus[s.status] %></span><% } %>
      <time><%= fmtDateTime(s.created_at) %></time>
    </div>
    <p class="items"><%= s.items %></p>
    <p class="meta"><%= s.source === 'job' ? 'Job ' + s.job_number : 'Van stock' %><% if (s.truck) { %> · Truck <%= s.truck %><% } %><% if (s.needed_by) { %> · Needed by <%= fmtDate(s.needed_by) %><% } %><% if (s.photo_path) { %> · <a href="/parts/photo/<%= s.id %>">Photo</a><% } %></p>
    <% var sn = splitNote(s.note); if (sn.text) { %><p class="meta">Note: <%= sn.text %></p><% } %><% if (sn.imported) { %><p class="meta"><span class="pill">Imported from the old form</span></p><% } %>
    <% if (s.admin_note) { %><p class="reply"><strong>Reply:</strong> <%= s.admin_note %></p><% } %>
    <% if (s.edited_at && !s.cancelled_at) { %><p class="meta">Edited <%= fmtDateTime(s.edited_at) %></p><% } %>
    <% if (s.can_change) { %>
    <div class="rec-actions">
      <a href="/parts/<%= s.id %>/edit">Edit</a>
      <form method="post" action="/parts/<%= s.id %>/cancel" data-confirm="Cancel this entry?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link" type="submit">Cancel entry</button></form>
    </div>
    <% } %>
  </li>
<% }) %>
</ul>

<h2>Training requests</h2>
<% if (!training.length) { %><p class="empty">Nothing yet. <a href="/training">Open the training form</a>.</p><% } %>
<ul class="records">
<% training.forEach(function (t) { %>
  <li class="card <%= t.cancelled_at ? 'cancelled' : '' %>">
    <div class="rec-head">
      <% if (t.unseen) { %><span class="tag new">Updated</span><% } %>
      <% if (t.cancelled_at) { %><span class="tag off">Cancelled</span><% } else { %><span class="status s-<%= t.status %>"><%= labels.trainingStatus[t.status] %></span><% } %>
      <% if (t.is_private) { %><span class="tag private">Private</span><% } %>
      <time><%= fmtDateTime(t.created_at) %></time>
    </div>
    <p class="items"><%= t.description %></p>
    <% if (t.admin_note) { %><p class="reply"><strong>Reply:</strong> <%= t.admin_note %></p><% } %>
    <% if (t.edited_at && !t.cancelled_at) { %><p class="meta">Edited <%= fmtDateTime(t.edited_at) %></p><% } %>
    <% if (t.can_change) { %>
    <div class="rec-actions">
      <a href="/training/<%= t.id %>/edit">Edit</a>
      <form method="post" action="/training/<%= t.id %>/cancel" data-confirm="Cancel this request?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link" type="submit">Cancel request</button></form>
    </div>
    <% } %>
  </li>
<% }) %>
</ul>
<% if (inspections.length) { %>
<h2>Truck inspections</h2>
<ul class="records">
  <% inspections.forEach(function (i) { %>
  <li class="card"><div class="rec-head"><strong>Truck <%= i.truck %></strong>
    <% if (i.problems && !i.resolved_at) { %><span class="tag overdue"><%= i.problems %> <%= i.problems === 1 ? 'problem' : 'problems' %> reported</span><% } else if (i.problems) { %><span class="tag return">Fixed</span><% } else { %><span class="tag return">All OK</span><% } %>
    <time><%= fmtDateTime(i.created_at) %></time></div>
    <% if (i.resolved_note) { %><p class="reply"><strong>Reply:</strong> <%= i.resolved_note %></p><% } %>
  </li>
  <% }) %>
</ul>
<% } %>
<% if (myCerts.length) { %>
<h2>My licenses and certifications</h2>
<ul class="records">
  <% myCerts.forEach(function (c) { %>
  <li class="card"><div class="rec-head"><strong><%= c.name %></strong>
    <% if (c.status === 'expired') { %><span class="tag overdue">Expired</span><% } else if (c.status === 'soon') { %><span class="tag request">Expires in <%= c.days %> <%= c.days === 1 ? 'day' : 'days' %></span><% } else if (c.status === 'ok') { %><span class="tag return">Current</span><% } %>
    <time><%= c.expires_on ? 'Expires ' + fmtDate(c.expires_on) : 'No expiry date' %></time></div>
    <% if (c.issuer || c.number) { %><p class="meta"><%= [c.issuer, c.number].filter(Boolean).join(' · ') %></p><% } %>
  </li>
  <% }) %>
</ul>
<% } %>
<% if (attended.length) { %>
<h2>Training attended</h2>
<ul class="records">
  <% attended.forEach(function (a) { %><li class="card"><div class="rec-head"><strong><%= a.title %></strong><time><%= fmtDate(a.session_date) %></time></div><% if (a.location) { %><p class="meta"><%= a.location %></p><% } %></li><% }) %>
</ul>
<% } %>
<p class="hint">You can edit or cancel a submission for <%= editWindowHours %> hours after sending it, until someone has acted on it. Anonymous complaints never appear here. Use your tracking code on the <a href="/complaint/status">complaint status page</a>.</p>
<%- include('partials/footer') %>
