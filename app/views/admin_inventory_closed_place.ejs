<%- include('partials/header', { wide: true }) %>
<% if (backToMonth) { %><p class="back"><a class="back-link" href="/admin/inventory/count/<%= audit.id %>">Inventory, <%= monthName(audit.month) %></a></p><% } %>
<h1><%= place.name %></h1>
<% var total = rows.reduce(function (n, r) { return n + (r.cost_cents === null ? 0 : r.cost_cents * r.quantity); }, 0); var units = rows.reduce(function (n, r) { return n + r.quantity; }, 0); %>
<p class="lede"><% var kindName = String(kinds[place.kind] || ''); var what = [kindName.toLowerCase() === String(place.name).toLowerCase() ? '' : kindName, technician || ''].filter(Boolean).join(', '); %><%= what ? what + '. ' : '' %>Inventory for <%= monthName(audit.month) %>, closed <%= fmtDateTime(audit.closed_at) %>. These are the figures as they stood then; nothing done since changes them.<% if (showCost) { %> Value at that day's costs: <strong>$<%= dollars(total) %></strong>.<% } %></p>
<% if (can('inventory.export')) { %><p class="filter-actions"><a class="btn small" href="/admin/inventory/count/<%= audit.id %>/<%= place.id %>/export.csv" data-no-soft download>Export for Excel</a></p><% } %>
<div class="table-wrap">
<table class="closed-place">
  <thead><tr><th>Part</th><th>Description</th><th class="num">On hand</th><% if (showCost) { %><th class="num">Cost each</th><th class="num">Value</th><% } %></tr></thead>
  <tbody>
  <% rows.forEach(function (r) { %>
  <tr>
    <td class="nowrap"><strong><%= r.part_number %></strong></td><td><%= r.description %></td><td class="num"><%= r.quantity %></td>
    <% if (showCost) { %><td class="num"><%= r.cost_cents === null ? '' : '$' + dollars(r.cost_cents) %></td><td class="num"><%= r.cost_cents === null ? '' : (r.quantity < 0 ? '-' : '') + '$' + dollars(Math.abs(r.cost_cents * r.quantity)) %></td><% } %>
  </tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="<%= showCost ? 5 : 3 %>" class="empty">This place held nothing when the month was closed.</td></tr><% } %>
  </tbody>
  <% if (rows.length) { %><tfoot><tr><td colspan="2"><strong>Total</strong></td><td class="num"><strong><%= units %></strong></td><% if (showCost) { %><td></td><td class="num"><strong><%= (total < 0 ? '-' : '') + '$' + dollars(Math.abs(total)) %></strong></td><% } %></tr></tfoot><% } %>
</table>
</div>
<%- include('partials/footer') %>
