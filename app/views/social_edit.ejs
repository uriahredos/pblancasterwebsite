<%- include('partials/header') %>
<% var target = comment ? '/social/comment/' + comment.id : '/social/' + post.id; %>
<p class="back"><a class="back-link" href="/social/p/<%= comment ? comment.post_id + '#c' + comment.id : post.id %>">Back to the post</a></p>
<h1><%= comment ? 'Edit comment' : 'Edit post' %></h1>
<%- include('partials/errors') %>
<form method="post" action="<%= target %>/edit" class="card stack social-new" data-no-live data-once>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label><span class="sr"><%= comment ? 'Your comment' : 'Your post' %></span>
    <textarea name="body" rows="<%= comment ? 4 : 6 %>" maxlength="<%= comment ? 1000 : 2000 %>"<%= comment ? ' required' : '' %>><%= values.body || '' %></textarea></label>
  <% if (post && post.photos.length) { %>
  <fieldset class="edit-photos"><legend>Photos <span class="hint">Tick any you want taken off.</span></legend>
    <% post.photos.forEach(function (ph) { %>
    <label class="edit-photo"><img src="/wall/photo/<%= ph.id %>" alt="Photo on this post"><span><input type="checkbox" name="drop" value="<%= ph.id %>"> Remove</span></label>
    <% }) %>
  </fieldset>
  <% } %>
  <button class="btn primary" type="submit">Save</button>
</form>
<%- include('partials/footer') %>
