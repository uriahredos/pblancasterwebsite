<%- include('partials/header') %>
<p><a href="/admin/parts">&larr; Parts log</a></p>
<h1><%= labels.action[s.action] %> · <%= s.display_name %><% if (s.cancelled_at) { %> <span class="tag off">Cancelled</span><% } %></h1>
<div class="card stack">
  <dl class="facts">
    <dt>Submitted</dt><dd><%= fmtDateTime(s.created_at) %></dd>
    <dt>For</dt><dd><%= s.source === 'job' ? 'Job ' + s.job_number : 'Van stock' %></dd>
    <% if (s.truck) { %><dt>Truck</dt><dd><%= s.truck %></dd><% } %>
    <% if (s.needed_by) { %><dt>Needed by</dt><dd><%= fmtDate(s.needed_by) %></dd><% } %>
    <% if (s.note) { %><dt>Note</dt><dd class="pre"><%= s.note %></dd><% } %>
  </dl>
  <table class="plain">
    <thead><tr><th>Part</th><th class="num">Qty</th></tr></thead>
    <tbody><% items.forEach(function (i) { %><tr><td><%= i.part_name %></td><td class="num"><%= i.quantity %></td></tr><% }) %></tbody>
  </table>
  <% if (s.photo_path) { %><a href="/parts/photo/<%= s.id %>"><img class="photo" src="/parts/photo/<%= s.id %>" alt="Photo of returned parts"></a><% } %>
</div>

<% if (history.length) { %>
<h2>Changes</h2>
<ul class="records">
  <% history.forEach(function (h) { %>
  <li class="card">
    <p><strong><%= h.change === 'cancelled' ? 'Cancelled' : 'Edited' %></strong> by <%= h.display_name %>, <%= fmtDateTime(h.changed_at) %></p>
    <% if (h.before) { %><p class="meta pre">Before: <%= h.before.items.map(function (i) { return i.quantity + ' × ' + i.part_name; }).join(', ') %> · <%= h.before.source === 'job' ? 'Job ' + h.before.job_number : 'Van stock' %><% if (h.before.needed_by) { %> · needed by <%= fmtDate(h.before.needed_by) %><% } %><% if (h.before.note) { %> · note: <%= h.before.note %><% } %></p><% } %>
  </li>
  <% }) %>
</ul>
<% } %>
<% if (!s.cancelled_at && can('parts.manage')) { %>
<div class="rec-actions spaced">
  <a class="btn small" href="/parts/<%= s.id %>/edit">Edit</a>
  <form method="post" action="/parts/<%= s.id %>/cancel" data-confirm="Cancel this?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small" type="submit">Cancel it</button></form>
</div>
<% } %>
<% if (s.action === 'request' && !s.cancelled_at && can('parts.manage')) { %>
<h2>Status</h2>
<form method="post" action="/admin/parts/<%= s.id %>/status" class="card stack">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Status
    <select name="status"><% Object.keys(labels.partsStatus).forEach(function (k) { %><option value="<%= k %>" <%= k === s.status ? 'selected' : '' %>><%= labels.partsStatus[k] %></option><% }) %></select>
  </label>
  <label>Reply to <%= s.display_name %> <span class="hint">Optional. They see it under My activity.</span>
    <textarea name="admin_note" rows="3" maxlength="1000"><%= s.admin_note || '' %></textarea>
  </label>
  <button class="btn primary" type="submit">Save</button>
</form>
<% } %>
<% if (can('records.delete')) { %>
<form method="post" action="/admin/parts/<%= s.id %>/delete" class="spaced danger-zone" data-confirm="Permanently delete this entry? This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small danger" type="submit">Delete this entry permanently</button></form>
<% } %>
<%- include('partials/footer') %>
