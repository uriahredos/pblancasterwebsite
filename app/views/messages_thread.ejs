<%- include('partials/header') %>
<p class="back"><a class="back-link" href="/messages">Messages</a></p>
<div class="dm-head"><%- include('partials/avatar', { who: t.other }) %><div class="grow"><h1><a href="/people/<%= t.other.id %>" data-no-card><%= t.other.display_name %></a></h1><p class="meta">Private: only you and <%= t.other.display_name %> can read this.<% if (t.other.job_title) { %> · <%= t.other.job_title %><% } %></p></div></div>
<% if (canSend) { %>
<section class="call dm-call" aria-label="Call">
  <div class="call-banner" data-call-banner>
    <% var dc = 'data-id="' + t.id + '" data-name="' + t.other.display_name.replace(/"/g, '&quot;') + '"'; %>
    <% if (!call || call.mineHost || call.mineGuest) { %>
    <button class="btn small" type="button" data-dcall="start" data-mode="audio" <%- dc %>><%- icons.phone %> Voice call</button>
    <button class="btn small" type="button" data-dcall="start" data-mode="video" <%- dc %>><%- icons.video %> Video call</button>
    <% } else { %>
    <span class="call-dot" aria-hidden="true"></span><span><strong><%= call.hostName %></strong> is calling you (<%= call.mode === 'audio' ? 'voice' : 'video' %>).</span>
    <button class="btn primary small" type="button" data-dcall="join" data-mode="<%= call.mode %>" <%- dc %>>Answer</button>
    <button class="btn small" type="button" data-dcall="decline" <%- dc %>>Decline</button>
    <% } %>
  </div>
  <% if (autoAnswer) { %><span hidden data-dcall-auto data-mode="<%= call.mode %>" <%- dc %>></span><% } %>
</section>
<% } %>
<%- include('partials/errors') %>
<div class="dm" data-live-dm="<%= t.id %>">
  <% rows.forEach(function (m) { var mine = m.user_id === me; %>
  <% if (m.kind === 'call') { %>
  <article class="dm-note" id="m<%= m.id %>" data-rev=""><p class="meta"><%- m.body === 'Voice call' ? icons.phone : icons.video %> <%= mine ? 'You called' : t.other.display_name + ' called you' %> · <%= m.body.toLowerCase() %> · <%= fmtDateTime(m.created_at) %></p></article>
  <% return; } %>
  <article class="dm-msg <%= mine ? 'mine' : 'theirs' %> <%= !mine && m.id > read && !m.removed_at ? 'is-new' : '' %>" id="m<%= m.id %>" data-rev="<%= m.removed_at || '' %>">
    <div class="dm-bubble">
      <% if (m.removed_at) { %><p class="meta removed-msg">Removed by the sender.</p><% } else { %><div class="msg-body"><%- fmt(m.body) %></div><% } %>
      <p class="meta dm-time"><%= fmtDateTime(m.created_at) %></p>
      <% if (!m.removed_at || !mine) { %>
      <details class="msg-more dm-more"><summary aria-label="Options for this message" title="Options">⋯</summary><div class="msg-tools">
        <% if (mine) { %>
        <form method="post" action="/messages/m/<%= m.id %>/delete" data-confirm="Remove this message? It goes for both of you."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link danger" type="submit">Remove</button></form>
        <% } else { %>
        <details class="msg-edit"><summary class="link">Report</summary>
          <form method="post" action="/messages/m/<%= m.id %>/report" class="stack" data-no-live data-confirm="Report this? The people who review reports will be able to read this conversation up to now."><input type="hidden" name="_csrf" value="<%= csrf %>">
            <label>What is wrong? <span class="hint">Optional.</span><textarea name="note" rows="2" maxlength="500"></textarea></label>
            <button class="btn small danger" type="submit">Report this message</button></form></details>
        <% } %>
      </div></details>
      <% } %>
    </div>
  </article>
  <% }) %>
</div>
<span id="end"></span>
<% if (canSend) { %>
<form method="post" action="/messages/c/<%= t.id %>/send" class="dm-compose" data-dm-send data-no-live>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label class="grow"><span class="sr">Your message</span><textarea name="body" rows="2" maxlength="4000" required placeholder="Write a message"></textarea></label>
  <button class="btn primary" type="submit">Send</button>
</form>
<p class="flash err dm-error" data-dm-error role="alert" hidden></p>
<% } else { %><p class="flash warn"><%= t.other.display_name %> cannot get messages any more.</p><% } %>
<script src="/live.js?v=<%= assetV %>" defer></script>
<script src="/messages.js?v=<%= assetV %>" defer></script>
<% if (autoAnswer) { %><script src="/dcall-auto.js?v=<%= assetV %>" defer></script><% } %>
<%- include('partials/footer') %>
