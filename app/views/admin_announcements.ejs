<%- include('partials/header', { wide: true }) %>
<p><a href="/notices">&larr; Notices</a></p>
<h1>Announcements</h1>
<p class="lede"><%= team ? 'What you post goes to the people you manage.' : 'What you post goes to everyone.' %> It shows at the top of their home page until they press "I have read this", then stays on the notice board.</p>
<div class="table-wrap">
<table>
  <thead><tr><th>Posted</th><th>Title</th><th>By</th><th>To</th><th>Read</th><th>Shown until</th><th></th></tr></thead>
  <tbody>
  <% rows.forEach(function (a) { %>
  <tr class="<%= a.expired ? 'off' : '' %>">
    <td class="nowrap"><%= fmtDateTime(a.created_at) %></td><td><a href="/admin/announcements/<%= a.id %>"><strong><%= a.title %></strong></a><% if (a.category && a.category !== 'general') { %> <span class="tag cat-<%= a.category %>"><%= categories[a.category] %></span><% } %><% if (a.pinned) { %> <span class="tag pin">Pinned</span><% } %></td><td><%= a.author %></td>
    <td><%= a.audience === 'team' ? 'Their people' : 'Everyone' %></td>
    <td><strong><%= a.read %> of <%= a.total %></strong></td>
    <td class="nowrap"><%= a.expires_on ? fmtDate(a.expires_on) + (a.expired ? ' (ended)' : '') : 'No end date' %></td>
    <td><a href="/admin/announcements/<%= a.id %>">Who has read it</a></td>
  </tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="7" class="empty">Nothing posted yet.</td></tr><% } %>
  </tbody>
</table>
</div>
<h2>Post an announcement</h2>
<%- include('partials/errors') %>
<form method="post" action="/admin/announcements" class="card stack">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Title <input name="title" value="<%= values.title || '' %>" required maxlength="120" autocomplete="off"></label>
  <label>Announcement <textarea name="body" rows="5" maxlength="4000" required><%= values.body || '' %></textarea></label>
  <label>About <span class="hint">Shows as a small label on the notice.</span>
    <select name="category"><% Object.keys(categories).forEach(function (k) { %><option value="<%= k %>" <%= (values.category || 'general') === k ? 'selected' : '' %>><%= categories[k] %></option><% }) %></select>
  </label>
  <label class="choice"><input type="checkbox" name="pinned" value="1" <%= values.pinned ? 'checked' : '' %>> Pin to the top of the notice board on the home page</label>
  <label>Show until <span class="hint">Optional. After this date it disappears for people who have not read it.</span>
    <input type="date" name="expires_on" value="<%= values.expires_on || '' %>">
  </label>
  <button class="btn primary" type="submit">Post</button>
</form>
<%- include('partials/footer') %>
