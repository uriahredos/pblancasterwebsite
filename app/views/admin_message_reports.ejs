<%- include('partials/header', { wide: true }) %>
<h1>Reported messages</h1>
<p class="lede">Private messages are only for the two people in them. A conversation shows up here only because one of them reported a message. You see it as it stood when it was reported, opening it is recorded in the activity log, and once a report is closed the conversation can no longer be read.</p>
<div class="table-wrap">
<table>
  <thead><tr><th>Reported</th><th>By</th><th>Between</th><th>What they said</th><th>Status</th><th></th></tr></thead>
  <tbody>
  <% rows.forEach(function (r) { %>
  <tr class="<%= r.closed_at ? 'off' : '' %>">
    <td class="nowrap"><%= fmtDateTime(r.created_at) %></td>
    <td><%= r.reporter %></td>
    <td><%= r.name_a %> and <%= r.name_b %></td>
    <td class="clamp"><%= r.note || '' %></td>
    <td><%= r.closed_at ? 'Closed' : r.opened_at ? 'Opened' : 'New' %></td>
    <td><a href="/admin/message-reports/<%= r.id %>">Open</a></td>
  </tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="6" class="empty">No reports.</td></tr><% } %>
  </tbody>
</table>
</div>
<%- include('partials/footer') %>
