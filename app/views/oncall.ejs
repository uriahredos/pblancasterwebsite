<%- include('partials/header', { wide: true }) %>
<h1>On call</h1>
<p class="lede">Who to call after hours<%= only ? ' at the ' + placeLabel(only.name) : many && market ? ' in the ' + market + ' market' : '' %>, and who is up next.</p>
<% if (choices.length) { %>
<form method="get" action="/oncall" class="oncall-show">
  <label>Show
    <select name="branch" data-autosubmit>
      <option value="all" <%= only ? '' : 'selected' %>>All <%= choices.length %> branches<%= market ? ' in the ' + market + ' market' : '' %></option>
      <% choices.forEach(function (c) { %><option value="<%= c.id %>" <%= only && only.id === c.id ? 'selected' : '' %>><%= c.name %><%= c.own ? ' (your branch)' : '' %></option><% }) %>
    </select>
  </label>
  <noscript><button class="btn small" type="submit">Show</button></noscript>
</form>
<% } %>

<section class="panel oncall-now" aria-labelledby="now-h">
  <div class="panel-head"><h2 id="now-h">On call now</h2></div>
  <% if (!current.length) { %><p class="empty">Nobody is listed as on call today<%= only ? ' for the ' + placeLabel(only.name) : '' %>.<%= canManage ? ' Add the schedule below.' : '' %></p><% } %>
  <% current.forEach(function (g) { %>
  <% if (many || g.market_id) { %><h3 class="sub-h"><%= g.market_id ? g.office : placeLabel(g.office) %></h3><% } %>
  <p class="meta oncall-range"><% if (canPick(g)) { %><input type="checkbox" class="oncall-pick" form="oncall-clear" name="ids" value="<%= g.tech.concat(g.backup).map(function (p) { return p.id; }).join(',') %>" aria-label="Select <%= g.office %>, <%= g.label %>"> <% } %><%= g.label %><%= g.note ? ' · ' + g.note : '' %></p>
  <ul class="oncall-people">
    <% g.tech.concat(g.backup).forEach(function (p) { %>
    <li class="role-<%= p.role %>">
      <span class="oncall-who"><span class="tag <%= p.role === 'tech' ? 'new' : '' %>"><%= roles[p.role] %></span><% if (p.covers) { %><span class="oncall-covers"><%= p.covers %></span><% } %><strong><%= p.name %></strong><% if (p.phone) { %><span class="meta"><%= p.phone %></span><% } %></span>
      <% if (p.phone) { %><a class="btn <%= p.role === 'tech' ? 'primary' : '' %>" href="tel:<%= p.tel %>" data-full data-call-number="<%= p.phone %>" data-call-name="<%= p.name %>">Call</a><% } else { %><span class="hint">No number listed</span><% } %>
    </li>
    <% }) %>
  </ul>
  <% }) %>
  <% if (many && missing.length && current.length) { %>
  <p class="hint oncall-missing"><strong>Nobody is listed today for <%= missing.length %> of the <%= officeCount %> branches in this market:</strong>
    <% missing.forEach(function (o, i) { %><%= i ? ', ' : '' %><a href="/branches/<%= o.id %>"><%= o.name %></a><% }) %>.
    Each branch loads its own schedule; until they do, call that branch directly.</p>
  <% } %>
</section>

<% if (rates.length || canManage) { %>
<h2 id="rates">On-call rates</h2>
<p class="hint">For the <%= rateOffice %> branch. Only its own people see these.</p>
<% if (rates.length) { %>
<div class="table-wrap">
<table class="rates-table">
  <thead><tr><th>For</th><th class="num">Rate</th><% if (canManage) { %><th></th><% } %></tr></thead>
  <tbody>
  <% rates.forEach(function (r) { %>
  <tr>
    <td><strong><%= r.label %></strong></td><td class="num"><%= r.rate %></td>
    <% if (canManage) { %><td>
      <details class="mod-tools">
        <summary>Change</summary>
        <form method="post" action="/admin/oncall/rates" class="stack thread-tools" data-no-live>
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= r.id %>">
          <label>For <input name="label" value="<%= r.label %>" required maxlength="80" autocomplete="off"></label>
          <label>Rate <input name="rate" value="<%= r.rate %>" required maxlength="80" autocomplete="off"></label>
          <div class="filter-actions"><button class="btn primary small" type="submit">Save</button>
            <button class="link" type="submit" name="remove" value="1" data-confirm="Remove the rate for &quot;<%= r.label %>&quot;?">Remove</button></div>
        </form>
      </details>
    </td><% } %>
  </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% } else { %><p class="card empty">No rates have been added for this branch yet.</p><% } %>
<% if (canManage) { %>
<form method="post" action="/admin/oncall/rates" class="filters card" data-no-live>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label class="grow">For <span class="hint">For example Weeknight, Weekend day, Holiday</span> <input name="label" required maxlength="80" autocomplete="off"></label>
  <label>Rate <span class="hint">For example $50, or $25 an hour</span> <input name="rate" required maxlength="80" autocomplete="off"></label>
  <div class="filter-actions"><button class="btn primary small" type="submit">Add rate</button></div>
</form>
<% } %>
<% } %>

<h2 id="schedule">Coming up</h2>
<% if (canManage && (current.some(canPick) || upcoming.some(canPick))) { %>
<form method="post" action="/admin/oncall/clear" id="oncall-clear" class="oncall-clear" data-no-live data-confirm="Remove the selected shifts from the schedule? This cannot be undone.">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label class="oncall-clear-all"><input type="checkbox" data-oncall-pick-all> Select all</label>
  <button class="btn small danger" type="submit" data-oncall-remove disabled>Remove selected</button>
  <span class="hint" data-oncall-count></span>
</form>
<% } %>
<%- include('partials/errors') %>
<% if (problems.length) { %><ul class="card hint"><% problems.forEach(function (p) { %><li><%= p %></li><% }) %></ul><% } %>
<% if (!upcoming.length) { %><p class="card empty">Nothing scheduled after the current shift<%= only ? ' for the ' + placeLabel(only.name) : '' %>.</p><% } else { %>
<div class="table-wrap">
<table class="oncall-table">
  <thead><tr><th>Days</th><% if (many) { %><th>Branch</th><% } %><th>On call</th><th>Backup</th><th>Holiday</th></tr></thead>
  <tbody>
  <% var lastYear = ''; upcoming.forEach(function (g) { %>
  <% if (g.year !== lastYear) { lastYear = g.year; %><tr class="year-row<%= g.later ? ' later' : '' %>"><td colspan="<%= many ? 5 : 4 %>"><%= g.year %></td></tr><% } %>
  <tr<%- g.later ? ' class="later"' : '' %>>
    <td class="nowrap" data-label="Days"><% if (canPick(g)) { %><input type="checkbox" class="oncall-pick" form="oncall-clear" name="ids" value="<%= g.tech.concat(g.backup).map(function (p) { return p.id; }).join(',') %>" aria-label="Select <%= g.office %>, <%= g.label %>"> <% } %><strong><%= g.label %></strong></td>
    <% if (many) { %><td data-label="Branch"><%= g.office %></td><% } %>
    <% ['tech', 'backup'].forEach(function (role) { %>
    <td data-label="<%= roles[role] %>">
      <% g[role].forEach(function (p) { %>
      <div class="oncall-cell"><span><% if (p.covers) { %><span class="oncall-covers"><%= p.covers %></span> <% } %><%= p.name %><% if (p.phone) { %> <a href="tel:<%= p.tel %>" data-full class="meta"><%= p.phone %></a><% } %></span>
        <% if (canManage && g.branch_id === mine) { %>
        <details class="row-menu"><summary aria-label="Change <%= p.name %>, <%= g.label %>" title="Change">⋯</summary>
          <div class="row-menu-list">
            <form method="post" action="/admin/oncall/<%= p.id %>" class="stack swap"><input type="hidden" name="_csrf" value="<%= csrf %>">
              <label>Swap for <input name="name" value="<%= p.name %>" maxlength="80" required autocomplete="off" list="oncall-people" data-fills-phone></label>
              <label>Phone <input name="phone" type="tel" value="<%= p.phone || '' %>" maxlength="30" autocomplete="off"></label>
              <button class="btn small" type="submit">Save</button>
            </form>
            <form method="post" action="/admin/oncall/<%= p.id %>/delete" data-confirm="Take <%= p.name %> off <%= g.label %>?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit">Remove from this shift</button></form>
          </div>
        </details>
        <% } %>
      </div>
      <% }) %>
    </td>
    <% }) %>
    <td data-label="Holiday"><%= g.note %></td>
  </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% if (laterCount) { %><p class="oncall-more"><button class="btn" type="button" data-oncall-all>Show the rest (<%= laterCount %> more)</button></p><% } %>
<% } %>

<% if (canManage) { %>
<datalist id="oncall-people"><% people.forEach(function (x) { %><option value="<%= x.name %>" data-id="<%= x.id %>" data-phone="<%= x.phone || '' %>" label="<%= x.office %>"></option><% }) %></datalist>
<details class="mod-tools spaced" <%= typeof addOpen !== 'undefined' && addOpen ? 'open' : '' %>>
  <summary>Add someone to the schedule</summary>
  <form method="post" action="/admin/oncall" class="oncall-add">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="user_id" value="">
    <div class="oncall-add-grid">
      <label class="w3">Name <input name="name" value="<%= values.name || '' %>" required maxlength="80" autocomplete="off" list="oncall-people" data-fills-phone data-picks-person placeholder="Search by name"></label>
      <label class="w3">Phone <input name="phone" type="tel" value="<%= values.phone || '' %>" maxlength="30" autocomplete="off" placeholder="Filled in from their account"></label>
      <label class="w2">First day <input type="date" name="start_on" value="<%= values.start_on || '' %>" required></label>
      <label class="w2">Handed on <input type="date" name="end_on" value="<%= values.end_on || '' %>" required></label>
      <label class="w2">Role <select name="role"><option value="tech" <%= values.role === 'backup' ? '' : 'selected' %>>On call</option><option value="backup" <%= values.role === 'backup' ? 'selected' : '' %>>Backup</option></select></label>
      <label class="w3">Covers <input name="covers" value="<%= values.covers || '' %>" maxlength="60" autocomplete="off" placeholder="Optional, like Sprinkler"></label>
      <label class="w3">Holiday <input name="note" value="<%= values.note || '' %>" maxlength="120" autocomplete="off" placeholder="Optional"></label>
    </div>
    <p class="hint">Handed on is the day the next person takes over.<%= widePick ? ' Someone from another branch goes on their own branch\'s schedule.' : '' %> Add as many people as you need for the same days.</p>
    <button class="btn primary" type="submit">Add to the schedule</button>
  </form>
</details>
<details class="mod-tools" <%= typeof importOpen !== 'undefined' && importOpen ? 'open' : '' %>>
  <summary>Load the year from the spreadsheet</summary>
  <form method="post" action="/admin/oncall/import" enctype="multipart/form-data" class="stack thread-tools" data-confirm="Load this file? It replaces the schedule for the days it covers.">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <p>Upload the on-call schedule saved as CSV (in Excel: File &gt; Save As &gt; CSV). A file with one line per person (columns Start, End, Branch, Covers, Role, Name, Phone, Holiday) is read too, and can fill several branches and the whole market at once.</p>
    <p>For the sheet as it is kept today: The year goes on the first line; then one line per shift with the month, the days, the technician and the manager, as the sheet is kept today.</p>
    <p class="hint">Extra columns of people are read too. A column headed "Backup" or "Manager" is a backup; any other is on call. Uploading again replaces the schedule for the days in the file.</p>
    <label>File <input type="file" name="file" accept=".csv,text/csv" required></label>
    <button class="btn primary" type="submit">Load the schedule</button>
  </form>
</details>
<% } %>
<%- include('partials/footer') %>
