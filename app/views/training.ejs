<%- include('partials/header') %>
<h1><%= editing ? 'Edit training request' : 'Training request' %></h1>
<% if (editing) { %>
<p class="lede">Sent <%= fmtDateTime(editing.created_at) %>. The change is recorded.</p>
<% } else { %>
<p class="lede">Submitting as <strong><%= user.display_name %></strong>.</p>
<% } %>
<% if (!editing) { %><p><a href="/training/topics">See what others have asked for</a> and add your name to a topic you want too.</p><% } %>
<%- include('partials/errors') %>
<form method="post" action="<%= editing ? '/training/' + editing.id + '/edit' : '/training' %>" class="card stack" <%- editing ? '' : 'data-draft="training:' + user.id + '"' %> <%- !editing && !errors.length ? 'data-draft-restore' : '' %> data-offline-guard>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Training description
    <span class="hint">What would you like training on? Panels, devices, procedures, anything.</span>
    <textarea name="description" rows="6" maxlength="4000" required><%= values.description || '' %></textarea>
  </label>
  <fieldset>
    <legend>Do you wish to be contacted regarding this request?</legend>
    <label class="choice"><input type="radio" name="wants_contact" value="yes" <%= values.wants_contact === 'yes' ? 'checked' : '' %> required> Yes</label>
    <label class="choice"><input type="radio" name="wants_contact" value="no" <%= values.wants_contact === 'no' ? 'checked' : '' %>> No</label>
  </fieldset>
  <fieldset>
    <legend>Should we keep this private?</legend>
    <label class="choice"><input type="radio" name="is_private" value="yes" <%= values.is_private === 'yes' ? 'checked' : '' %> required> Yes</label>
    <label class="choice"><input type="radio" name="is_private" value="no" <%= values.is_private === 'no' ? 'checked' : '' %>> No</label>
  </fieldset>
  <p class="flash err" id="offline-msg" role="alert" hidden>No connection right now, so this was not sent. What you typed is saved on this phone. Try again when you have signal.</p>
  <button class="btn primary" type="submit"><%= editing ? 'Save changes' : 'Send request' %></button>
</form>
<%- include('partials/footer') %>
