<%- include('partials/header', { wide: true }) %>
<div class="title-row"><h1>Users</h1><span class="filter-actions"><a class="btn primary small" href="/admin/users/invite">Send sign-in details</a><% if (can('profiles.manage')) { %><a class="btn small" href="/admin/profiles">Profiles and permissions</a><% } %></span></div>
<%- include('partials/users_tabs', { tab: 'accounts' }) %>
<% if (created) { %>
<div class="card code-card">
  <p>Account <strong><%= created.username %></strong> <%= created.what === 'reset' ? 'has a new temporary password' : 'was created' %>.</p>
  <p class="mini">Temporary password</p>
  <p class="code"><%= created.password %></p>
  <p>Give this to the person now. It is shown only once, and they will be asked to choose their own password when they sign in.</p>
</div>
<% } %>
<%- include('partials/errors') %>
<% if (duplicates.length) { var dupCount = duplicates.reduce(function (n, g) { return n + g.extras.length; }, 0); %>
<div class="card dup-card" id="duplicates">
  <div class="rec-head"><strong><%= dupCount %> duplicate <%= dupCount === 1 ? 'account' : 'accounts' %> found</strong>
    <% if (dupCount > 1) { %><form method="post" action="/admin/users/duplicates" data-no-live data-confirm="Remove all <%= dupCount %> duplicate accounts? Anything recorded under them moves to the account that is kept. This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="all" value="1"><button class="btn small" type="submit">Remove all <%= dupCount %></button></form><% } %></div>
  <p class="hint">The same person is on the list twice in one office, and the extra account is disabled or has no role. Removing it moves anything recorded under it (and its job title, email or phone if the other account lacks them) to the account that is kept.</p>
  <ul class="dup-list">
  <% duplicates.forEach(function (g) { g.extras.forEach(function (e) { %>
    <li>
      <span><strong><%= g.keep.display_name %></strong><% if (g.keep.branch_name) { %> <span class="pill"><%= g.keep.branch_name %></span><% } %><br>
        <span class="meta">Keep <strong><%= g.keep.username %></strong> (<%= g.keep.active ? (g.keep.must_change_password ? 'not signed in yet' : 'active') : 'disabled' %><%= g.keep.job_title ? ', ' + g.keep.job_title : ', no role' %>) · remove <strong><%= e.username %></strong> (<%= e.active ? 'active' : 'disabled' %><%= e.job_title ? ', ' + e.job_title : ', no role' %>)</span></span>
      <form method="post" action="/admin/users/duplicates" data-no-live data-confirm="Remove the account <%= e.username %> and keep <%= g.keep.username %>? This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="keep" value="<%= g.keep.id %>"><input type="hidden" name="extra" value="<%= e.id %>"><button class="btn small" type="submit">Remove duplicate</button></form>
    </li>
  <% }) }) %>
  </ul>
</div>
<% } %>
<% if (canAdd && disabledCount) { %>
<div class="card dup-card" id="disabled">
  <div class="rec-head"><strong><%= disabledCount %> disabled <%= disabledCount === 1 ? 'account' : 'accounts' %></strong>
    <form method="post" action="/admin/users/remove-disabled" data-no-live data-confirm="Remove all <%= disabledCount %> disabled accounts for good?<%= disabledListed ? ' ' + disabledListed + ' of them are people shown in the People list who have no sign-in; they will leave the People list and the chart.' : '' %> This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small danger" type="submit">Remove all <%= disabledCount %></button></form></div>
  <p class="hint">Disabled accounts cannot sign in.<% if (disabledListed) { %> <strong><%= disabledListed %> of these <%= disabledListed === 1 ? 'is a person' : 'are people' %> from the office contact list who <%= disabledListed === 1 ? 'has' : 'have' %> no sign-in yet.</strong> They still show in People and on the organization chart; removing them takes them out of both. To give one of them a sign-in instead, choose Enable from the menu on their row.<% } %> Download a backup first if you are unsure.</p>
</div>
<% } %>
<% if (canAdd) { %>
<h2>Add a person</h2>
<form method="post" action="/admin/users" class="filters card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Username <input name="username" value="<%= values.username || '' %>" required maxlength="40" autocapitalize="none" autocomplete="off" placeholder="jsmith"></label>
  <label>Full name <input name="display_name" value="<%= values.display_name || '' %>" required maxlength="80" autocomplete="off" placeholder="John Smith"></label>
  <label>Email <span class="hint">Optional</span> <input name="email" type="email" value="<%= values.email || '' %>" maxlength="120" autocomplete="off"></label>
  <label>Role
    <select name="job_title" id="add-role">
      <option value="">None yet</option>
      <% roles.forEach(function (r) { %><option value="<%= r.name %>" data-profile="<%= r.profile_id || '' %>" <%= values.job_title === r.name ? 'selected' : '' %>><%= r.name %></option><% }) %>
    </select>
  </label>
  <label>Profile
    <select name="profile_id" id="add-profile" required>
      <option value="">Choose one</option>
      <% profiles.forEach(function (p) { %><option value="<%= p.id %>" <%= String(values.profile_id) === String(p.id) ? 'selected' : '' %>><%= p.name %></option><% }) %>
    </select>
  </label>
  <div class="filter-actions"><button class="btn primary small" type="submit">Add person</button></div>
</form>
<p class="hint">A temporary password is generated for you and shown once after you add the person. It works for <%= tempPasswordDays %> days; after that, send fresh sign-in details. The role places them on the chart; the profile decides what they can do, and is filled in for you when the role gives one.</p>
<% } else { %>
<p class="lede">These are the people assigned to you.</p>
<% } %>

<h2><%= canAdd ? 'Everyone' : 'Your people' %></h2>
<div class="filters users-find">
  <label class="grow">Find a person <input type="search" id="users-find" placeholder="Name, username, office or profile" autocomplete="off"></label>
  <label>Account
    <select id="users-state"><option value="">Any</option><option value="Temporary password">Temporary password (not signed in yet)</option><option value="Active">Active</option><option value="Disabled">Disabled</option></select>
  </label>
</div>
<p class="meta" id="users-count" data-total="<%= users.length %>"><%= users.length %> <%= users.length === 1 ? 'person' : 'people' %></p>
<div class="table-wrap">
<table id="users-table">
  <thead><tr><th>Name</th><th>Office</th><th>Username</th><th>Profile</th><th>Managed by</th><th>Account</th><th><span class="sr">Actions</span></th></tr></thead>
  <tbody>
  <% users.forEach(function (u) { %>
  <tr class="<%= u.active ? '' : 'off' %>">
    <td><%= u.display_name %><% if (u.id === user.id) { %> <span class="hint">(you)</span><% } %></td>
    <td><%= u.branch_name || '' %></td>
    <td><%= u.username %></td>
    <td><% if (u.is_master) { %><span class="tag master">Master</span><% } else { %><%= u.profile_name || 'None' %><% if (u.profile_scope === 'team') { %> <span class="hint">· <%= u.team_size %> <%= u.team_size === 1 ? 'person' : 'people' %></span><% } %><% } %></td>
    <td><%= u.managers || '' %></td>
    <td data-state><%= !u.active ? 'Disabled' : u.must_change_password ? (u.tempExpired ? 'Temporary password expired' : 'Temporary password') : 'Active' %></td>
    <td class="row-more">
      <% if (u.manageable) { %>
      <details class="row-menu">
        <summary aria-label="Actions for <%= u.display_name %>" title="Actions">⋯</summary>
        <div class="row-menu-list">
          <a href="/admin/users/<%= u.id %>/edit">Edit</a>
          <form method="post" action="/admin/users/<%= u.id %>/reset-password" data-confirm="Give <%= u.display_name %> a new temporary password?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit">Reset password</button></form>
          <% if (u.id !== user.id && !u.is_master) { %>
          <form method="post" action="/admin/users/<%= u.id %>/toggle-active"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit"><%= u.active ? 'Disable' : 'Enable' %></button></form>
          <hr>
          <form method="post" action="/admin/users/<%= u.id %>/remove" data-no-live data-confirm="Remove <%= u.display_name %> for good? Their sign-in and details are erased and they leave every list. What they recorded for the office is kept. This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit" class="danger-text">Remove for good</button></form>
          <% } %>
        </div>
      </details>
      <% } else { %><span class="hint"><%= u.is_master ? 'Protected' : 'Has more access than you' %></span><% } %>
    </td>
  </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% if (can('activity.view')) { %><p class="hint spaced"><a href="/admin/activity">Activity log</a>: who changed what.</p><% } %>
<% if (can('backups')) { %><p class="hint spaced"><a href="/admin/backups">Backups</a>: download a copy of the site's data.</p><% } %>
<script src="/users.js?v=<%= assetV %>"></script>
<%- include('partials/footer') %>
