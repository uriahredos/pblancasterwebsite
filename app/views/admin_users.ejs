<%- include('partials/header', { wide: true }) %>
<div class="title-row"><h1>Users</h1><% if (can('profiles.manage')) { %><a class="btn small" href="/admin/profiles">Profiles and permissions</a><% } %></div>
<% if (created) { %>
<div class="card code-card">
  <p>Account <strong><%= created.username %></strong> <%= created.what === 'reset' ? 'has a new temporary password' : 'was created' %>.</p>
  <p class="mini">Temporary password</p>
  <p class="code"><%= created.password %></p>
  <p>Give this to the person now. It is shown only once, and they will be asked to choose their own password when they sign in.</p>
</div>
<% } %>
<%- include('partials/errors') %>
<% if (canAdd) { %>
<h2>Add a person</h2>
<form method="post" action="/admin/users" class="filters card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Username <input name="username" value="<%= values.username || '' %>" required maxlength="40" autocapitalize="none" autocomplete="off" placeholder="jsmith"></label>
  <label>Full name <input name="display_name" value="<%= values.display_name || '' %>" required maxlength="80" autocomplete="off" placeholder="John Smith"></label>
  <label>Email <span class="hint">Optional</span> <input name="email" type="email" value="<%= values.email || '' %>" maxlength="120" autocomplete="off"></label>
  <label>Profile
    <select name="profile_id" required>
      <option value="">Choose one</option>
      <% profiles.forEach(function (p) { %><option value="<%= p.id %>" <%= String(values.profile_id) === String(p.id) ? 'selected' : '' %>><%= p.name %></option><% }) %>
    </select>
  </label>
  <div class="filter-actions"><button class="btn primary small" type="submit">Add person</button></div>
</form>
<p class="hint">A temporary password is generated for you and shown once after you add the person. The profile decides what they can do.</p>
<% } else { %>
<p class="lede">These are the people assigned to you.</p>
<% } %>

<h2><%= canAdd ? 'Everyone' : 'Your people' %></h2>
<div class="table-wrap">
<table>
  <thead><tr><th>Name</th><th>Username</th><th>Profile</th><th>Managed by</th><th>Account</th><th>Actions</th></tr></thead>
  <tbody>
  <% users.forEach(function (u) { %>
  <tr class="<%= u.active ? '' : 'off' %>">
    <td><%= u.display_name %><% if (u.id === user.id) { %> <span class="hint">(you)</span><% } %></td>
    <td><%= u.username %></td>
    <td><% if (u.is_master) { %><span class="tag master">Master</span><% } else { %><%= u.profile_name || 'None' %><% if (u.profile_scope === 'team') { %> <span class="hint">· <%= u.team_size %> <%= u.team_size === 1 ? 'person' : 'people' %></span><% } %><% } %></td>
    <td><%= u.managers || '' %></td>
    <td><%= !u.active ? 'Disabled' : u.must_change_password ? 'Temporary password' : 'Active' %></td>
    <td class="row-actions">
      <% if (u.manageable) { %>
      <a href="/admin/users/<%= u.id %>/edit">Edit</a>
      <form method="post" action="/admin/users/<%= u.id %>/reset-password" data-confirm="Give <%= u.display_name %> a new temporary password?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link" type="submit">Reset password</button></form>
      <% if (u.id !== user.id && !u.is_master) { %>
      <form method="post" action="/admin/users/<%= u.id %>/toggle-active"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link" type="submit"><%= u.active ? 'Disable' : 'Enable' %></button></form>
      <% } %>
      <% } else { %><span class="hint"><%= u.is_master ? 'Protected' : 'Has more access than you' %></span><% } %>
    </td>
  </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% if (can('backups')) { %><p class="hint spaced"><a href="/admin/backups">Backups</a>: download a copy of the site's data.</p><% } %>
<%- include('partials/footer') %>
