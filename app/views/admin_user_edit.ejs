<%- include('partials/header') %>
<p class="back"><a class="back-link" href="/admin/users">Users</a></p>
<h1>Edit <%= target.display_name %><% if (target.is_master) { %> <span class="tag master">Master</span><% } %></h1>
<%- include('partials/errors') %>
<form method="post" action="/admin/users/<%= target.id %>/edit" class="card stack">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Full name <span class="hint">Shown on their submissions and in the logs.</span>
    <input name="display_name" value="<%= values.display_name %>" required maxlength="80" autocomplete="off">
  </label>
  <label>Username <span class="hint">What they type to sign in. If you change it, tell them.</span>
    <input name="username" value="<%= values.username %>" required maxlength="40" autocapitalize="none" autocomplete="off">
  </label>
  <label>Email <span class="hint">Optional</span>
    <input name="email" type="email" value="<%= values.email || '' %>" maxlength="120" autocomplete="off">
  </label>

  <label>Usual truck <span class="hint">Optional. Filled in for them on the parts form.</span>
    <input name="default_truck" value="<%= values.default_truck || '' %>" maxlength="20" autocomplete="off">
  </label>

  <% if (branches.length > 1) { %>
  <label>Branch <span class="hint">Moving someone to another branch takes them out of any manager's team.</span>
    <select name="branch_id"><% branches.forEach(function (b) { %><option value="<%= b.id %>" <%= b.id === target.branch_id ? 'selected' : '' %>><%= b.name %></option><% }) %></select>
  </label>
  <% } %>

  <% if (target.is_master) { %>
  <p class="notice">This is the master account. It can do everything, and nobody else can edit it, disable it or change what it can do.</p>
  <% } else if (canSetProfile) { %>
  <label>Profile <span class="hint">Decides what this person can do.<% if (can('profiles.manage')) { %> Change what a profile allows on the <a href="/admin/profiles">Profiles</a> page.<% } %></span>
    <select name="profile_id" required>
      <% if (!profiles.some(function (p) { return p.id === target.profile_id; })) { %><option value=""><%= profile ? profile.name : 'Choose one' %></option><% } %>
      <% profiles.forEach(function (p) { %><option value="<%= p.id %>" <%= p.id === target.profile_id ? 'selected' : '' %>><%= p.name %></option><% }) %>
    </select>
  </label>
  <% } else { %>
  <p class="meta">Profile: <strong><%= profile ? profile.name : 'None' %></strong><% if (target.id === user.id) { %>. You cannot change your own profile.<% } %></p>
  <% } %>

  <% if (canSetTeam) { %>
  <fieldset>
    <legend>People <%= target.display_name %> manages</legend>
    <p class="hint">The <%= profile.name %> profile only sees its own people. Tick everyone <%= target.display_name %> should see and manage.</p>
    <input type="hidden" name="team_form" value="1">
    <div class="check-grid">
      <% people.forEach(function (p) { %>
      <label class="choice"><input type="checkbox" name="team" value="<%= p.id %>" <%= team.indexOf(p.id) >= 0 ? 'checked' : '' %>> <%= p.display_name %><% if (!p.active) { %> <span class="hint">(disabled)</span><% } %></label>
      <% }) %>
    </div>
  </fieldset>
  <% } %>
  <button class="btn primary" type="submit">Save</button>
</form>
<h2 id="welcome">Announce as a new hire</h2>
<form method="post" action="/admin/users/<%= target.id %>/welcome" class="card stack">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <p class="plain"><% if (welcome) { %>Announced on <%= fmtDateTime(welcome.created_at) %>. It shows on everyone's home page for 14 days from then, with a button to say welcome.<% } else { %>Puts <%= target.display_name %> on everyone's home page for 14 days, with a button for people to say welcome.<% } %></p>
  <div class="two">
    <label>Job title <input name="job_title" value="<%= target.job_title || '' %>" maxlength="80" autocomplete="off"></label>
    <label>Start date <input type="date" name="started_on" value="<%= target.started_on || '' %>"></label>
  </div>
  <label>A few words about them <span class="hint">Optional. Where they came from, what they will be doing.</span>
    <textarea name="intro" rows="3" maxlength="600"><%= welcome ? welcome.intro || '' : '' %></textarea>
  </label>
  <div class="filter-actions">
    <button class="btn primary" type="submit"><%= welcome ? 'Save announcement' : 'Announce' %></button>
    <% if (welcome) { %><button class="btn" type="submit" name="remove" value="1">Take it down</button><% } %>
  </div>
</form>
<%- include('partials/footer') %>
