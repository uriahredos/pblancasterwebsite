<%- include('partials/header') %>
<p class="back"><a class="back-link" href="/people">People</a></p>
<div class="card person-head">
  <%- include('partials/avatar', { who: p, size: 'xl' }) %>
  <div class="person-text">
    <h1><%= p.display_name %></h1>
    <p class="meta"><%= [p.job_title, p.department].filter(Boolean).join(' · ') %><% if (p.branch) { %><%= p.job_title || p.department ? ' · ' : '' %><a href="/branches/<%= p.branch_id %>"><%= p.branch %> office</a><% } %></p>
    <% if (p.tenure) { %><p class="meta"><%= p.tenure %><%= p.started_on ? ' · started ' + fmtDate(p.started_on) : '' %></p><% } %>
    <% if (bday) { %><p class="meta">🎂 <%= bday %></p><% } %>
    <p class="filter-actions"><% if (me) { %><a class="btn small" href="/profile">Edit my profile</a><% } else { %><% if (p.email) { %><a class="btn primary small teams" href="https://teams.microsoft.com/l/chat/0/0?users=<%= encodeURIComponent(p.email) %>" target="_blank" rel="noopener noreferrer">Chat in Teams</a><% } %><a class="btn small" href="/shoutouts?to=<%= p.id %>#give">👏 Give a shout-out</a><% } %><% if (canPosition) { %><a class="btn small" href="/admin/users/positions?who=<%= p.id %>">Edit job title and department</a><% } %></p>
    <% if (canWelcome) { %><form method="post" action="/admin/users/<%= p.id %>/welcome" data-no-live data-confirm="Take down the new-hire welcome for <%= p.display_name %>? It leaves everyone's home page. Their account is not affected."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="remove" value="1"><input type="hidden" name="back" value="person"><button class="btn small danger" type="submit">Take down the new-hire welcome</button></form><% } %>
  </div>
</div>
<% if (reportsTo || theirTeam.length) { %>
<h2>Team</h2>
<div class="card stack">
  <% if (reportsTo) { %><p class="plain"><span class="meta">Reports to</span> <a href="/people/<%= reportsTo.id %>"><strong><%= reportsTo.display_name %></strong></a><% if (reportsTo.job_title) { %> <span class="meta">· <%= reportsTo.job_title %></span><% } %></p><% } %>
  <% if (theirTeam.length) { %><p class="plain"><span class="meta"><%= theirTeam.length %> <%= theirTeam.length === 1 ? 'person reports' : 'people report' %> to <%= p.display_name.split(' ')[0] %></span></p>
  <ul class="roster"><% theirTeam.forEach(function (m) { %><li><a href="/people/<%= m.id %>"><%- include('partials/avatar', { who: m }) %><span class="person-text"><strong><%= m.display_name %></strong><span class="meta"><%= m.job_title || '' %></span></span></a></li><% }) %></ul><% } %>
</div>
<% } %>
<% if (p.about) { %><h2>About</h2><div class="card"><p class="pre"><%= p.about %></p></div><% } %>
<% if (p.skillList.length) { %><h2>Knows about</h2><div class="card"><p class="chips big"><% p.skillList.forEach(function (s) { %><a class="skill" href="/people?q=<%= encodeURIComponent(s) %>"><%= s %></a><% }) %></p></div><% } %>
<% if (certs.length) { %><h2>Certifications</h2><div class="card"><ul class="ticks"><% certs.forEach(function (c) { %><li><%= c %></li><% }) %></ul></div><% } %>
<% if (p.phone || p.email) { %>
<h2>Contact</h2>
<div class="card stack">
  <% if (p.phone) { %><p class="plain"><span class="meta">Phone</span> <a href="tel:<%= p.phone.replace(/[^0-9+]/g, '') %>"><%= p.phone %></a></p><% } %>
  <% if (p.email) { %><p class="plain"><span class="meta">Email</span> <a href="mailto:<%= p.email %>"><%= p.email %></a></p><% } %>
</div>
<% } %>
<% if (!p.active) { %><p class="hint"><%= p.display_name.split(' ')[0] %> is not using this site yet.</p><% } %>
<% if (!p.about && !p.skillList.length && !certs.length && !p.phone && !p.email && !shouts.length) { %><p class="card empty"><%= me ? 'Your profile is empty. Add a photo and a few words so people know who you are.' : p.display_name.split(' ')[0] + ' has not filled in a profile yet.' %></p><% } %>
<% if (shouts.length) { %>
<h2 id="shoutouts">Shout-outs</h2>
<div class="card"><ul class="shouts"><% shouts.forEach(function (s) { %><%- include('partials/shout', { s: s, back: 'person' }) %><% }) %></ul></div>
<% } %>
<% if (welcome) { %>
<h2 id="welcome">Welcome messages</h2>
<div class="card stack">
  <% if (welcome.intro) { %><p class="pre"><%= welcome.intro %></p><% } %>
  <% if (!notes.length) { %><p class="empty"><%= me ? 'Nobody has said hello yet.' : 'Be the first to say hello.' %></p><% } %>
  <ul class="notes">
    <% notes.forEach(function (n) { %><li><%- include('partials/avatar', { who: n, size: 'sm' }) %><span><a href="/people/<%= n.id %>"><strong><%= n.display_name %></strong></a> <%= n.message || 'said welcome 👋' %>
      <% if (n.id === user.id || canModNotes) { %><details class="msg-more"><summary aria-label="Edit or remove this message" title="Edit or remove">⋯</summary><div class="msg-tools">
        <% if (n.id === user.id) { %><details class="msg-edit"><summary class="link">Edit</summary><form method="post" action="/welcome/<%= welcome.id %>/note/<%= n.id %>/edit" class="filters" data-no-live><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="grow"><span class="sr">Your message</span><input name="message" value="<%= n.message || '' %>" maxlength="200" autocomplete="off"></label><div class="filter-actions"><button class="btn primary small" type="submit">Save</button></div></form></details><% } %>
        <form method="post" action="/welcome/<%= welcome.id %>/note/<%= n.id %>/delete" data-no-live data-confirm="<%= n.id === user.id ? 'Remove your message?' : 'Remove this message from ' + n.display_name + '?' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link danger" type="submit">Remove<%= n.id === user.id ? '' : ' (admin)' %></button></form></div></details><% } %></span></li><% }) %>
  </ul>
  <% if (!me) { %>
  <form method="post" action="/welcome/<%= welcome.id %>/wave" class="filters">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="grow"><span class="sr">Message</span><input name="message" maxlength="200" autocomplete="off" placeholder="Say something (optional)"></label>
    <div class="filter-actions"><button class="btn primary" type="submit">👋 Welcome <%= p.display_name.split(' ')[0] %></button></div>
  </form>
  <% } %>
</div>
<% } %>
<%- include('partials/footer') %>
