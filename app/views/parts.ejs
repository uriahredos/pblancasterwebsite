<%- include('partials/header') %>
<h1><%= editing ? 'Edit parts entry' : 'Parts' %></h1>
<% if (editing) { %>
<p class="lede"><%= labels.action[editing.action] %>, sent <%= fmtDateTime(editing.created_at) %>. The change is recorded.</p>
<% } else { %>
<p class="lede">Submitting as <strong><%= user.display_name %></strong>.</p>
<% } %>
<%- include('partials/errors') %>
<% var rows = values.items && values.items.length ? values.items : [{ part_name: '', quantity: '' }]; %>
<form method="post" action="<%= editing ? '/parts/' + editing.id + '/edit' : '/parts' %>" enctype="multipart/form-data" class="card stack" id="parts-form" <%- editing ? '' : 'data-draft="parts:' + user.id + '"' %> <%- !editing && !errors.length ? 'data-draft-restore' : '' %> data-offline-guard>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <fieldset>
    <legend>What would you like to do?</legend>
    <div class="segmented <%= editing ? 'single' : '' %>">
      <% (editing ? [editing.action] : ['take', 'return', 'request']).forEach(function (a) { %>
      <label><input type="radio" name="action" value="<%= a %>" <%= values.action === a ? 'checked' : '' %> required><span><%= labels.action[a] %></span></label>
      <% }) %>
    </div>
  </fieldset>

  <fieldset>
    <legend>Parts</legend>
    <div id="items">
      <% rows.forEach(function (it, i) { %>
      <div class="item-row">
        <label class="grow suggest-wrap"><span class="<%= i ? 'sr' : 'mini' %>">Part name or number</span>
          <input name="part_name" value="<%= it.part_name %>" maxlength="200" placeholder="e.g. SIGA-CT2" autocapitalize="characters" autocomplete="off"></label>
        <label class="qty"><span class="<%= i ? 'sr' : 'mini' %>">Qty</span>
          <input name="quantity" value="<%= it.quantity %>" inputmode="numeric" pattern="[0-9]*" maxlength="5" placeholder="1" autocomplete="off"></label>
        <button type="button" class="icon remove-row" aria-label="Remove this part" hidden>&times;</button>
      </div>
      <% }) %>
    </div>
    <div class="filter-actions">
      <button type="button" class="btn small" id="add-row" hidden>+ Add another part</button>
      <button type="button" class="btn small" id="scan-btn" hidden>Scan barcode</button>
    </div>
    <% if (frequent && frequent.length) { %>
    <div class="chips" id="frequent" hidden>
      <span class="mini">Your usual parts. Tap to add:</span>
      <% frequent.forEach(function (name) { %><button type="button" class="chip" data-part="<%= name %>"><%= name %></button><% }) %>
    </div>
    <% } %>
    <noscript><p class="hint">To enter more than one part, send the form once per part.</p></noscript>
  </fieldset>

  <fieldset>
    <legend>Van stock or job?</legend>
    <label class="choice"><input type="radio" name="source" value="van" <%= values.source === 'van' ? 'checked' : '' %> required> Van stock</label>
    <label class="choice"><input type="radio" name="source" value="job" <%= values.source === 'job' ? 'checked' : '' %>> Job</label>
    <label data-show-source="job">Job number
      <input name="job_number" value="<%= values.job_number || '' %>" maxlength="60" inputmode="text" autocomplete="off" placeholder="e.g. 49020597">
    </label>
  </fieldset>

  <label>Truck <span class="hint">Optional. Remembered for next time.</span>
    <input name="truck" value="<%= values.truck || '' %>" maxlength="20" autocomplete="off" placeholder="e.g. 309">
  </label>

  <label data-show-action="request">Needed by
    <input type="date" name="needed_by" value="<%= values.needed_by || '' %>">
  </label>

  <label data-show-action="return">Photo of the returned parts <span class="hint">Optional. JPEG or PNG, up to 10 MB.<% if (editing && values.photo_path) { %> A photo is already attached; choosing a new one replaces it.<% } %></span>
    <input type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/gif">
  </label>

  <label>Note <span class="hint">Optional. Where it was left, anything useful.</span>
    <textarea name="note" rows="2" maxlength="1000"><%= values.note || '' %></textarea>
  </label>

  <p class="flash err" id="offline-msg" role="alert" hidden>No connection right now, so this was not sent. What you typed is saved on this phone. Try again when you have signal.</p>
  <button class="btn primary" type="submit"><%= editing ? 'Save changes' : 'Submit' %></button>
</form>
<div class="scan-overlay" id="scan-overlay" hidden>
  <div class="scan-box card">
    <p><strong>Point the camera at the barcode</strong></p>
    <div id="scan-view"></div>
    <p class="hint" id="scan-msg">Starting the camera…</p>
    <button type="button" class="btn" id="scan-close">Close</button>
  </div>
</div>
<script src="/parts-form.js" defer></script>
<script src="/scan.js" defer></script>
<%- include('partials/footer') %>
