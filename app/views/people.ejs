<%- include('partials/header') %>
<div class="title-row"><h1>People</h1><span class="filter-actions"><% if (can('users.manage')) { %><a class="btn small" href="/admin/users/positions">Edit positions</a><% } %><a class="btn small" href="/profile">Edit my profile</a></span></div>
<p class="lede">Everyone at the company who uses this site. Search by name, job, or what they know.</p>
<form method="get" action="/people" class="filters">
  <label class="grow">Search <input name="q" value="<%= q %>" maxlength="60" placeholder="A name, a job, or a skill such as EST3" autocomplete="off"></label>
  <% if (branches.length > 1) { %>
  <label>Office <select name="branch"><option value="">All offices</option><% branches.forEach(function (b) { %><option value="<%= b.id %>" <%= branch === b.id ? 'selected' : '' %>><%= b.name %></option><% }) %></select></label>
  <% } %>
  <% if (departments.length) { %>
  <label>Department <select name="dept"><option value="">All departments</option><% departments.forEach(function (d) { %><option value="<%= d %>" <%= dept === d ? 'selected' : '' %>><%= d %></option><% }) %></select></label>
  <% } %>
  <div class="filter-actions"><button class="btn primary" type="submit">Search</button><% if (q || branch || dept) { %><a class="btn" href="/people">Clear</a><% } %></div>
</form>
<p class="meta"><%= people.length %> <%= people.length === 1 ? 'person' : 'people' %><%= q || branch || dept ? ' found, of ' + total : '' %></p>
<% if (!people.length) { %><p class="card empty">Nobody matches that. Try a shorter search.</p><% } %>
<ul class="people">
  <% people.forEach(function (p) { %>
  <li><a href="/people/<%= p.id %>">
    <%- include('partials/avatar', { who: p, size: 'lg' }) %>
    <span class="person-text">
      <strong><%= p.display_name %></strong>
      <span class="meta"><%= [p.job_title, p.department, branches.length > 1 ? p.branch : ''].filter(Boolean).join(' · ') || p.branch || 'No details yet' %></span>
      <% if (p.skillList.length) { %><span class="chips"><% p.skillList.slice(0, 4).forEach(function (s) { %><span class="skill"><%= s %></span><% }) %><% if (p.skillList.length > 4) { %><span class="skill more">+<%= p.skillList.length - 4 %></span><% } %></span><% } %>
    </span>
  </a><% if (p.email && p.id !== user.id) { %><a class="teams-mini" href="https://teams.microsoft.com/l/chat/0/0?users=<%= encodeURIComponent(p.email) %>" target="_blank" rel="noopener noreferrer" title="Chat with <%= p.display_name %> in Teams" aria-label="Chat with <%= p.display_name %> in Teams"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H10l-4.500 3.500V16H4z"/><path d="M8 9.500h8M8 12.500h5"/></svg></a><% } %></li>
  <% }) %>
</ul>
<%- include('partials/footer') %>
