{
  "name": "Pye-Barker Lancaster Branch Portal",
  "short_name": "PB Lancaster",
  "description": "Parts sign-out, training requests and anonymous complaints for the Lancaster branch.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#12283f",
  "theme_color": "#12283f",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Take parts", "url": "/parts?action=take" },
    { "name": "Return parts", "url": "/parts?action=return" },
    { "name": "Request parts", "url": "/parts?action=request" },
    { "name": "Training request", "url": "/training" }
  ]
}
